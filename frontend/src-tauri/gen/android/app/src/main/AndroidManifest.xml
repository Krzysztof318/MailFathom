<?xml version="1.0" encoding="utf-8"?>
<!--
     Generated by `tauri android init` and then edited by hand, which is what committing this project is for. Everything
     this repository decided about the Android head that Tauri's configuration has no key for is here rather than in a
     step somebody has to remember to run.

     One permission, and it is the one the client cannot work without: it talks to a deployment over HTTP. Nothing else
     is asked for — no storage, no contacts, no camera, no location, and no notification permission, which arrives with
     the notification itself under issue 1620 rather than ahead of it.

     Three things the template declared are gone rather than kept: the leanback feature and the TV launcher category,
     which would put this on the launcher of a device class nothing here is designed for — the client composes from a
     width and a pointer, and neither describes a television; and the `FileProvider` over the whole cache and external
     root, which nothing shares a file through today, so what it would buy is a grantable handle over the WebView's own
     mail-derived cache. Whatever first needs to share a file declares the one directory it shares.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         `allowBackup` and `dataExtractionRules` are both ADR 0027's, and both halves are the decision: the first turns
         off the cloud backup that would otherwise copy whatever this head keeps on the device to a vendor, and from API
         31 it no longer dependably governs device-to-device transfer, which is what the second one excludes. What is
         kept here is the deployment address, the theme, the language, how the Mail space divides its width, the
         WebView's own storage and cache for pages that rendered mail, and — once issue 1619 lands — the credential. A
         nightly promises none of it survives anything, so an off-device copy buys a person nothing and costs them mail
         metadata somewhere they never put it.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MailFathom"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
