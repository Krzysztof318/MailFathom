{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailFathom",
  "identifier": "io.github.krzysztof318.mailfathom",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../src/Client.App/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "MailFathom",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "category": "Productivity",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "shortDescription": "A brain for your mail — self-hosted, AI-native, and yours alone.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
