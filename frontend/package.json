{
  "name": "mailfathom-client-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mailfathom/client-app run dev",
    "build": "pnpm --filter @mailfathom/client-app run build",
    "desktop:dev": "jiti src-tauri/run-tauri.ts dev",
    "desktop:build": "jiti src-tauri/run-tauri.ts build",
    "android:init": "jiti src-tauri/run-tauri.ts android init",
    "android:dev": "jiti src-tauri/run-tauri.ts android dev",
    "android:build": "jiti src-tauri/run-tauri.ts android build --apk --debug --target aarch64 x86_64",
    "typecheck": "tsc --noEmit --project . && tsc --noEmit --project src/Client.Backend && tsc --noEmit --project src/Client.App",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.18",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
