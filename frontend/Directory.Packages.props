<Project>
  <!-- The client stack's package pins, and only its own. Nothing is shared with backend/Directory.Packages.props: a
       version that appears in both is written twice on purpose, because the two stacks move independently and a single
       file above them would make every backend bump a client bump as well.

       What is absent here is the larger half of what the client restores. Uno.Sdk supplies the version of every Uno
       package a head pulls in, chosen from the SDK version pinned in the repository-root global.json and from the
       `UnoFeatures` the project declares, so upgrading Uno is a change to that one pin rather than to a list of
       thirty. See https://aka.platform.uno/using-uno-sdk#implicit-packages. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.13.1" />
  </ItemGroup>

  <!-- A version for a package nothing here compiles against and no artifact carries. `Uno.WinUI.Runtime.Skia.X11`
       declares `LibVLCSharp` unconditionally in its own package metadata, so the desktop head resolved it and copied
       `LibVLCSharp.dll` into every publish; `frontend/src/Client/Client.csproj` now names it directly with every asset
       excluded, and central package management wants a version on a direct reference whether or not its assets flow.

       The number is the floor `Uno.WinUI.Runtime.Skia.X11` declares at the Uno.Sdk version global.json pins, rather
       than a choice of this repository, and what matters about it is only that it is not *below* that floor: restore
       resolves the higher of the two, so moving this line forward changes nothing an artifact sees, while an Uno bump
       that raises the floor past it fails with NU1605 instead of drifting quietly. -->
  <ItemGroup>
    <PackageVersion Include="LibVLCSharp" Version="3.7.0" />
  </ItemGroup>

  <!-- What the client's own service assembly restores. Microsoft.Extensions.Http is the typed-client registration and
       the delegating-handler pipeline; a plain net10.0 library resolves it as an ordinary package rather than from a
       shared framework, which is why it is pinned here and nowhere in the backend's own list. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
