<Page x:Class="MailFathom.Client.Presentation.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MailFathom.Client.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer IsTabStop="True">
    <!-- SafeArea for the reason the connect screen carries it: this is the other screen whose whole purpose is
         typing, so the keyboard must not come up over the box being typed into. -->
    <Grid utu:SafeArea.Insets="VisibleBounds,SoftInput">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>

      <utu:NavigationBar x:Uid="SignInPage.NavigationBar.Title" />

      <!-- One column, capped rather than fixed, so the block reads the same in a phone-width window and stops growing
           into a line nobody can follow on a wide desktop one. -->
      <StackPanel Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="420"
                  Padding="24"
                  Spacing="20">

        <TextBlock x:Uid="SignInPage.TextBlock.Lead"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="8">
          <TextBlock x:Name="UsernameLabel"
                     x:Uid="SignInPage.TextBlock.Username"
                     Style="{StaticResource BodyTextBlockStyle}" />

          <!-- Two-way, because what is typed is the state the model reads when the button is pressed rather than
               something read off the control. The label above names the control to a screen reader as well as to a
               reader, which is why it is bound rather than repeated. -->
          <TextBox x:Uid="SignInPage.TextBox.Username"
                   Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}"
                   IsSpellCheckEnabled="False"
                   HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock x:Name="PasswordLabel"
                     x:Uid="SignInPage.TextBlock.Password"
                     Style="{StaticResource BodyTextBlockStyle}" />

          <!-- A PasswordBox rather than a TextBox, so the characters are never drawn and no predictive keyboard or
               spelling engine sees them. Its Password property is what carries the value, and it updates the state as
               it is typed for the same reason the box above does.

               No x:Uid, deliberately: there is nothing on this control for a table to answer. The label above names it
               to a reader and, through LabeledBy, to a screen reader, and a placeholder inside a box that draws dots
               would be a word nobody sees once anything is typed. -->

          <PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                       HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- What this head does with the credential once it is accepted, shown only where there is something to say:
             a head that keeps it says nothing, because opening already signed in is what somebody expects. It is
             Informational rather than a warning — nothing is wrong, and the person is being told what to expect. -->
        <InfoBar x:Uid="SignInPage.InfoBar.Keeping"
                 IsOpen="{Binding SaysHowLongItLasts}"
                 IsClosable="False"
                 Message="{Binding Keeping}"
                 Severity="Informational" />

        <!-- The refusal, in the language being read in. Error because nothing was accepted and nothing was kept: the
             credential is still waiting to be corrected. -->
        <InfoBar x:Uid="SignInPage.InfoBar.Refusal"
                 IsOpen="{Binding IsRefused}"
                 IsClosable="False"
                 Message="{Binding Refusal}"
                 Severity="Error" />

        <Button x:Uid="SignInPage.Button.SignIn"
                Command="{Binding SignIn}"
                IsEnabled="{Binding CanSignIn}"
                Style="{StaticResource FilledButtonStyle}"
                HorizontalAlignment="Stretch" />

        <!-- A deployment that is not answering takes as long as the configured timeout, so the screen says it is still
             asking rather than appearing to have ignored the press. -->
        <ProgressRing IsActive="{Binding IsAsking}"
                      HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
