<Page x:Class="MailFathom.Client.Presentation.Workspace.WorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mailboxes="using:MailFathom.Client.Presentation.Mailboxes"
      xmlns:spaces="using:MailFathom.Client.Presentation.Spaces"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!-- SafeArea keeps every composition below clear of a notch, a rounded corner, and a system bar. It is stated once
       at the root because the toolkit insets an element by how much of it the unsafe area actually covers, so the
       bottom navigation nested inside adds nothing on top of what is taken here. The soft keyboard is the one mask
       that cannot be attached to an ordinary element — the toolkit supports `SoftInput` on a SafeArea or a
       ScrollViewer alone, and warns at run time rather than failing — so it is stated below, around the text this
       frame owns.

       Named, because the rows of the mailbox tree reach the frame's model through it: a template's own data context is
       the row it draws, so the commands a row presses are bound by naming the element whose context is the model. -->
  <Grid x:Name="WorkspaceRoot"
        uen:Region.Attached="True"
        utu:SafeArea.Insets="VisibleBounds">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>

        <!-- Bottom navigation over one column, which is the composition a window narrower than every breakpoint below
             lands in. It states a trigger of its own rather than relying on being first: a state no trigger selects is
             never entered, so a group whose narrowest member carries none falls back to what the elements were
             authored with instead — which here is the rail, on a phone. -->
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Spaces.Visibility" Value="Visible" />
            <Setter Target="Rail.IsPaneToggleButtonVisible" Value="False" />
            <Setter Target="Rail.IsPaneVisible" Value="False" />
            <Setter Target="Rail.PaneDisplayMode" Value="LeftMinimal" />
            <Setter Target="Rail.IsPaneOpen" Value="False" />

            <!-- The tree comes over the content and starts closed, because a phone has no room to hold it beside
                 anything. It is one press away rather than a screen away, which is what keeps changing folder from
                 being a navigation. -->
            <Setter Target="MailboxPane.DisplayMode" Value="Overlay" />
            <Setter Target="MailboxPane.IsPaneOpen" Value="False" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="Normal">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="{StaticResource WorkspaceRailWindowWidth}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Spaces.Visibility" Value="Collapsed" />
            <Setter Target="Rail.IsPaneToggleButtonVisible" Value="True" />
            <Setter Target="Rail.IsPaneVisible" Value="True" />
            <Setter Target="Rail.PaneDisplayMode" Value="LeftCompact" />

            <!-- Beside the content rather than over it, and open, because where somebody is reading is the first thing
                 a window with room for it should say. -->
            <Setter Target="MailboxPane.DisplayMode" Value="Inline" />
            <Setter Target="MailboxPane.IsPaneOpen" Value="True" />
          </VisualState.Setters>
        </VisualState>

        <!-- The wide composition differs from the one above only in what the workspace beside the rail does with the
             room, which WorkspaceColumns decides at the same breakpoint. -->
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="{StaticResource WorkspaceWideWindowWidth}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Spaces.Visibility" Value="Collapsed" />
            <Setter Target="Rail.IsPaneToggleButtonVisible" Value="True" />
            <Setter Target="Rail.IsPaneVisible" Value="True" />
            <Setter Target="Rail.PaneDisplayMode" Value="LeftCompact" />
            <Setter Target="MailboxPane.DisplayMode" Value="Inline" />
            <Setter Target="MailboxPane.IsPaneOpen" Value="True" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- The rail and the bottom navigation are one navigation rather than two: both are regions, and an item in
         either names the same route as its counterpart, so whichever the width put in front of somebody moves the
         same content area. -->
    <NavigationView x:Name="Rail"
                    uen:Region.Attached="True"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    PaneDisplayMode="LeftCompact">
      <NavigationView.MenuItems>
        <!-- Each destination is present only where the session says this caller may reach it, which is what makes a
             capability the credential does not carry absent rather than present and refused when it is pressed. The
             converter collapses anything that is not an outright yes, so a session still being fetched offers
             nothing. -->
        <NavigationViewItem x:Uid="Workspace.Rail.Discover"
                            uen:Region.Name="Discover"
                            Visibility="{Binding OffersDiscover, Converter={StaticResource AffirmedVisibility}}">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Find" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Workspace.Rail.Mail"
                            uen:Region.Name="Mail"
                            Visibility="{Binding OffersMail, Converter={StaticResource AffirmedVisibility}}">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Mail" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Workspace.Rail.Cases"
                            uen:Region.Name="Cases"
                            Visibility="{Binding OffersCases, Converter={StaticResource AffirmedVisibility}}">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Folder" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.Content>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- What the frame owns above the spaces: the field the product puts a question in, and the indicator
               beside it saying what that question would be asked against. Neither runs anything here — the field
               holds what somebody typed, the indicator reads the scope, and both survive moving between spaces
               because both live in the workspace rather than in the space on screen. -->
          <Grid Padding="16,12"
                ColumnSpacing="12"
                Background="{ThemeResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- What opens and closes the tree. It is bound to the pane rather than to the model because what is open
                 is a fact about this window rather than about the workspace: the scope the tree chose is what travels,
                 and it travels whether or not anybody is looking at the tree. It is offered at every width, since a
                 wide window is also where somebody wants the room back. -->
            <ToggleButton x:Uid="Workspace.Toggle.Mailboxes"
                          IsChecked="{Binding IsPaneOpen, ElementName=MailboxPane, Mode=TwoWay}"
                          VerticalAlignment="Center">
              <SymbolIcon Symbol="List" />
            </ToggleButton>

            <!-- The one place this frame takes typing, and therefore the one place the soft keyboard can cover
                 something: SafeArea as a control rather than as an attached mask, which is what the `SoftInput` mask
                 is supported on. A space that takes typing of its own says the same thing around its own field. -->
            <!-- The field follows the space that would run what is typed into it: asking is Discover's act, so a
                 credential that may not ask is not offered a field to ask in. -->
            <utu:SafeArea Grid.Column="1"
                          Insets="SoftInput"
                          Visibility="{Binding OffersDiscover, Converter={StaticResource AffirmedVisibility}}">
              <TextBox x:Uid="Workspace.TextBox.Intent"
                       Text="{Binding Intent, Mode=TwoWay}"
                       MaxWidth="720"
                       HorizontalAlignment="Stretch" />
            </utu:SafeArea>

            <!-- Bound to the feed's value rather than displayed through a FeedView, because MVUX projects a feed of a
                 scalar as the scalar itself: the generated bindable exposes this one as a `string`, and a FeedView
                 handed a string has no feed to render. A FeedView is what a feed of a record is shown through — as
                 the settings screen shows its build — and this indicator becomes one the day a scope is resolved
                 against the deployment and can therefore be loading or failed. -->
            <Border Grid.Column="2"
                    Padding="12,6"
                    CornerRadius="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SecondaryContainerBrush}">
              <!-- No x:Uid: the words are the scope itself, resolved in the model because they are composed from what
                   is in scope rather than fixed per control. -->
              <TextBlock Text="{Binding ScopeDescription}"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource OnSecondaryContainerBrush}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="280" />
            </Border>

            <!-- The one destination that is not a space, so it is reached from the frame rather than named beside
                 the three. It is a route like every other, which is what puts it on the stack the system back
                 gesture and the browser's history move through. -->
            <Button x:Uid="Workspace.Button.Settings"
                    Grid.Column="3"
                    uen:Navigation.Request="Settings"
                    VerticalAlignment="Center"
                    Style="{StaticResource TextBlockButtonStyle}">
              <SymbolIcon Symbol="Setting" />
            </Button>
          </Grid>

          <!-- What the session is doing, and what it means when it cannot be had. The frame renders it rather than
               each space, because until it arrives no space knows what it may show — and a shell that said nothing
               while the answer was unknown would be the empty frame this replaces. It sits in its own Auto row, so
               the whole block takes no height at all once there is an answer and nothing to say about it. -->
          <StackPanel Grid.Row="1"
                      Padding="16,0,16,12"
                      Spacing="8">
            <!-- Whether the client reaches its deployment at all, which is the first of the three facts a screen must
                 not blur and the one every other notice below rests on. It is the frame's rather than a space's
                 because it is about this client rather than about any mailbox: a person whose network dropped and a
                 person whose mail provider is refusing connections need different sentences, and this is the first
                 of the two. -->
            <InfoBar x:Uid="Workspace.InfoBar.Reaching"
                     IsOpen="{Binding IsRetryingDeployment}"
                     IsClosable="False"
                     Severity="Warning">
              <!-- The attempt beside the sentence rather than folded into it: seeing the count move is what tells
                   somebody the client is working rather than stuck, which is the whole reason this is shown. -->
              <InfoBar.Content>
                <TextBlock Text="{Binding ConnectionAttempt}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
              </InfoBar.Content>
            </InfoBar>

            <!-- The client has stopped asking on its own, so the next ask is a person's. Its own notice rather than
                 the failed-session one below, because the two lead to different acts — a connection to look at, and a
                 sign-in to repeat. -->
            <InfoBar x:Uid="Workspace.InfoBar.DeploymentLost"
                     IsOpen="{Binding HasLostDeployment}"
                     IsClosable="False"
                     Severity="Error">
              <InfoBar.ActionButton>
                <Button x:Uid="Workspace.Button.RetrySession"
                        Command="{Binding RetrySession}" />
              </InfoBar.ActionButton>
            </InfoBar>

            <!-- A grant of nothing is an answer rather than a failure, and it is the one a person can act on with
                 their operator. It is read from the frame rather than from the state's own template so the sentence
                 does not depend on which of the three spaces resolved how. -->
            <InfoBar x:Uid="Workspace.InfoBar.NothingOffered"
                     IsOpen="{Binding OffersNothing}"
                     IsClosable="False"
                     Severity="Warning" />

            <!-- Two notices rather than one, and they are two because the acts they lead to are. A credential that
                 does not carry something is widened by whoever runs the deployment; a deployment that does not have
                 something is not widened by any credential at all, and telling somebody "you may not" there sends
                 them looking for a permission nobody can give them. Both can stand at once, which is the honest
                 reading of a session that withheld two things for two reasons. -->
            <InfoBar x:Uid="Workspace.InfoBar.Ungranted"
                     IsOpen="{Binding AnythingUngranted}"
                     IsClosable="False"
                     Severity="Informational" />

            <InfoBar x:Uid="Workspace.InfoBar.Unavailable"
                     IsOpen="{Binding AnythingUnavailable}"
                     IsClosable="False"
                     Severity="Informational" />

            <mvux:FeedView Source="{Binding Session}">
              <!-- Nothing: an answer that arrived is said by the shell itself rather than by a banner over it. -->
              <mvux:FeedView.ValueTemplate>
                <DataTemplate>
                  <Border Height="0" />
                </DataTemplate>
              </mvux:FeedView.ValueTemplate>

              <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                  <ProgressBar IsIndeterminate="True"
                               HorizontalAlignment="Stretch" />
                </DataTemplate>
              </mvux:FeedView.ProgressTemplate>

              <!-- What it means and what to try, in this application's own words: the failure carries an English
                   message written for a log, and one of the four cases can carry text from a machine this process
                   does not own. The retry reaches the model through the template's parent, because asking the
                   deployment again is the session's act rather than this view's.

                   Shown only where the deployment answered, so this and the lost-connection notice above never speak
                   at once: a session that failed because nothing was answering is said there, and what is left here
                   is the deployment being present and refusing this client a session. -->
              <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                  <InfoBar x:Uid="Workspace.InfoBar.SessionUnavailable"
                           IsOpen="{Binding Parent.HasReachedDeployment}"
                           IsClosable="False"
                           Severity="Error">
                    <InfoBar.ActionButton>
                      <Button x:Uid="Workspace.Button.RetrySession"
                              Command="{Binding Parent.RetrySession}" />
                    </InfoBar.ActionButton>
                  </InfoBar>
                </DataTemplate>
              </mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>
          </StackPanel>

          <!-- The mailboxes and their folders as one tree, which is the client's scope selector: what a row narrows
               to is what the list, the search, and the field above are all about. It belongs to the frame rather than
               to the Mail space for exactly that reason, and it is a pane rather than a column so the same tree
               stands beside the content where there is room for it and over the content where there is not. -->
          <SplitView x:Name="MailboxPane"
                     Grid.Row="2"
                     DisplayMode="Overlay"
                     PanePlacement="Left"
                     OpenPaneLength="300"
                     IsPaneOpen="False"
                     PaneBackground="{ThemeResource SurfaceBrush}">
            <SplitView.Pane>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Padding="16,12,16,8"
                            Spacing="8">
                  <TextBlock x:Uid="Workspace.TextBlock.Mailboxes"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />

                  <!-- A deployment that has stopped refreshing changes what every sentence below means, so it is said
                       once above them rather than repeated on each row. -->
                  <InfoBar x:Uid="Workspace.InfoBar.MailboxesPaused"
                           IsOpen="{Binding MailboxesPaused}"
                           IsClosable="False"
                           Severity="Warning" />
                </StackPanel>

                <mvux:FeedView Grid.Row="1"
                               Source="{Binding Mailboxes}">
                  <mvux:FeedView.ValueTemplate>
                    <DataTemplate>
                      <!-- One flat, virtualized list rather than a tree of containers: the nesting is on the row, so
                           an owner with several mailboxes and a provider that nests deeply costs the same as one with
                           a handful of folders. Which row is current is the workspace's scope rather than this
                           control's selection, so a space that narrowed the scope some other way marks the same row
                           without this control being told. -->
                      <ListView ItemsSource="{Binding Data}"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                Padding="8,0,8,12">
                        <ListView.ItemTemplate>
                          <DataTemplate x:DataType="mailboxes:MailboxRow">
                            <Grid>
                              <!-- What is in scope is marked behind the row rather than on its words, so the row
                                   reads as current without the sentence on it depending on being read in colour. -->
                              <Border CornerRadius="6"
                                      Background="{ThemeResource SecondaryContainerBrush}"
                                      Visibility="{x:Bind IsSelected, Converter={StaticResource AffirmedVisibility}}" />

                              <Grid Padding="2,4"
                                    ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Nesting is a width rather than a margin, which keeps every row's disclosure
                                     control on the same grid as the one above it. -->
                                <Border Width="{x:Bind IndentWidth}" />

                                <!-- Two controls rather than one with a glyph that turns: each is shown on an
                                     outright yes, so a row with nothing nested under it carries neither and a row
                                     whose state has not been decided carries neither either. -->
                                <Button x:Uid="Workspace.Button.OpenMailboxRow"
                                        Grid.Column="1"
                                        Command="{Binding DataContext.ToggleMailbox, ElementName=WorkspaceRoot}"
                                        CommandParameter="{x:Bind Key}"
                                        Visibility="{x:Bind CanOpen, Converter={StaticResource AffirmedVisibility}}"
                                        Style="{StaticResource TextBlockButtonStyle}">
                                  <FontIcon Glyph="&#xE76C;"
                                            FontSize="12" />
                                </Button>

                                <Button x:Uid="Workspace.Button.CloseMailboxRow"
                                        Grid.Column="1"
                                        Command="{Binding DataContext.ToggleMailbox, ElementName=WorkspaceRoot}"
                                        CommandParameter="{x:Bind Key}"
                                        Visibility="{x:Bind CanClose, Converter={StaticResource AffirmedVisibility}}"
                                        Style="{StaticResource TextBlockButtonStyle}">
                                  <FontIcon Glyph="&#xE70D;"
                                            FontSize="12" />
                                </Button>

                                <!-- The row itself is what narrows the workspace. A level of a mail server's
                                     hierarchy that is not a folder narrows nothing, and is drawn without being a
                                     choice rather than being a choice that refuses. -->
                                <Button Grid.Column="2"
                                        Command="{Binding DataContext.SelectMailbox, ElementName=WorkspaceRoot}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{x:Bind IsSelectable}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource TextBlockButtonStyle}">
                                  <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                      <TextBlock Text="{x:Bind Name}"
                                                 Style="{StaticResource BodyTextBlockStyle}"
                                                 Foreground="{ThemeResource OnSurfaceBrush}"
                                                 TextTrimming="CharacterEllipsis" />

                                      <!-- How much mail is held here, beside the name rather than under it, because
                                           it is what the row is about rather than something about its copy. -->
                                      <TextBlock Text="{x:Bind StoredText}"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource CaptionTextBlockStyle}"
                                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                    </StackPanel>

                                    <!-- How current the copy is, on the rows that stand for one. Three separable
                                         facts, drawn as three things and never as a spinner: a mail server that did
                                         not answer, an attempt that went wrong, and mail still outstanding. -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind ShowsCopyState, Converter={StaticResource AffirmedVisibility}}">
                                      <Border Width="8"
                                              Height="8"
                                              CornerRadius="4"
                                              VerticalAlignment="Center"
                                              Background="{ThemeResource ErrorBrush}"
                                              Visibility="{x:Bind IsFailing, Converter={StaticResource AffirmedVisibility}}" />

                                      <Border Width="8"
                                              Height="8"
                                              CornerRadius="4"
                                              VerticalAlignment="Center"
                                              Background="{ThemeResource TertiaryBrush}"
                                              Visibility="{x:Bind IsUnreachable, Converter={StaticResource AffirmedVisibility}}" />

                                      <TextBlock Text="{x:Bind Standing}"
                                                 Style="{StaticResource CaptionTextBlockStyle}"
                                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                 TextWrapping="Wrap" />

                                      <TextBlock Text="{x:Bind Freshness}"
                                                 Style="{StaticResource CaptionTextBlockStyle}"
                                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                 TextWrapping="Wrap" />

                                      <!-- Its own words rather than a fourth standing, because a copy can be behind
                                           under any of them: an attempt that succeeded within its batch budget
                                           leaves mail for the next one. -->
                                      <TextBlock x:Uid="Workspace.TextBlock.MailboxBehind"
                                                 Style="{StaticResource CaptionTextBlockStyle}"
                                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                 TextWrapping="Wrap"
                                                 Visibility="{x:Bind IsBehind, Converter={StaticResource AffirmedVisibility}}" />
                                    </StackPanel>
                                  </StackPanel>
                                </Button>

                                <!-- Unread mail is a count somebody acts on, so it is a mark rather than another
                                     sentence, and it is absent rather than reading zero where there is none. -->
                                <Border Grid.Column="3"
                                        Padding="6,1"
                                        CornerRadius="9"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource PrimaryBrush}"
                                        Visibility="{x:Bind HasUnread, Converter={StaticResource AffirmedVisibility}}">
                                  <TextBlock Text="{x:Bind UnreadText}"
                                             Style="{StaticResource CaptionTextBlockStyle}"
                                             Foreground="{ThemeResource OnPrimaryBrush}" />
                                </Border>
                              </Grid>
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </DataTemplate>
                  </mvux:FeedView.ValueTemplate>

                  <mvux:FeedView.ProgressTemplate>
                    <DataTemplate>
                      <ProgressBar IsIndeterminate="True"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch" />
                    </DataTemplate>
                  </mvux:FeedView.ProgressTemplate>

                  <!-- Owning no mailbox is a state rather than an empty tree: it says what it is and what to do about
                       it, which is a thing an operator does on the administrative surface rather than here. -->
                  <mvux:FeedView.NoneTemplate>
                    <DataTemplate>
                      <InfoBar x:Uid="Workspace.InfoBar.NoMailbox"
                               IsOpen="True"
                               IsClosable="False"
                               Severity="Informational" />
                    </DataTemplate>
                  </mvux:FeedView.NoneTemplate>

                  <!-- What it means and what to try, in this application's own words: the failure carries an English
                       message written for a log, and one of the four cases can carry text from a machine this process
                       does not own. Asking again is reached through the template's parent, because it is the
                       session's act rather than this view's. -->
                  <mvux:FeedView.ErrorTemplate>
                    <DataTemplate>
                      <InfoBar x:Uid="Workspace.InfoBar.MailboxesUnavailable"
                               IsOpen="True"
                               IsClosable="False"
                               Severity="Error">
                        <InfoBar.ActionButton>
                          <Button x:Uid="Workspace.Button.RetryMailboxes"
                                  Command="{Binding Parent.RetryMailboxes}" />
                        </InfoBar.ActionButton>
                      </InfoBar>
                    </DataTemplate>
                  </mvux:FeedView.ErrorTemplate>
                </mvux:FeedView>

                <!-- What the tree is instead where the session does not offer correspondence at all: the same words
                     every withheld space uses, over the pane rather than over the window. -->
                <spaces:WithheldOverlay Grid.RowSpan="2"
                                        Withheld="{Binding WithholdsMail}" />
              </Grid>
            </SplitView.Pane>

            <!-- Left empty deliberately: navigation resolves a registered route and puts the view for it here. -->
            <Grid uen:Region.Attached="True"
                  uen:Region.Navigator="Visibility" />
          </SplitView>

          <utu:TabBar x:Name="Spaces"
                      Grid.Row="3"
                      uen:Region.Attached="True"
                      Style="{StaticResource BottomTabBarStyle}"
                      Visibility="Collapsed">
            <!-- The same three destinations under the same three conditions: the bottom navigation is the narrow
                 composition of one navigation rather than a second one, so what it offers follows the session
                 exactly as the rail does. -->
            <utu:TabBarItem x:Uid="Workspace.Tab.Discover"
                            uen:Region.Name="Discover"
                            Visibility="{Binding OffersDiscover, Converter={StaticResource AffirmedVisibility}}">
              <utu:TabBarItem.Icon>
                <SymbolIcon Symbol="Find" />
              </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem x:Uid="Workspace.Tab.Mail"
                            uen:Region.Name="Mail"
                            Visibility="{Binding OffersMail, Converter={StaticResource AffirmedVisibility}}">
              <utu:TabBarItem.Icon>
                <SymbolIcon Symbol="Mail" />
              </utu:TabBarItem.Icon>
            </utu:TabBarItem>
            <utu:TabBarItem x:Uid="Workspace.Tab.Cases"
                            uen:Region.Name="Cases"
                            Visibility="{Binding OffersCases, Converter={StaticResource AffirmedVisibility}}">
              <utu:TabBarItem.Icon>
                <SymbolIcon Symbol="Folder" />
              </utu:TabBarItem.Icon>
            </utu:TabBarItem>
          </utu:TabBar>
        </Grid>
      </NavigationView.Content>
    </NavigationView>
  </Grid>
</Page>
