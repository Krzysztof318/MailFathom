<UserControl x:Class="MailFathom.Client.Presentation.Search.MailSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:messages="using:MailFathom.Client.Presentation.Messages"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:search="using:MailFathom.Client.Presentation.Search"
             xmlns:utu="using:Uno.Toolkit.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Padding="12,8"
          ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Uid="MailSearchView.Button.Close"
              Command="{Binding CloseSearch}">
        <FontIcon Glyph="&#xE72B;"
                  FontSize="14" />
      </Button>

      <TextBox x:Uid="MailSearchView.TextBox.Query"
               Grid.Column="1"
               Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               utu:CommandExtensions.Command="{Binding SearchMail}" />

      <Button x:Uid="MailSearchView.Button.Search"
              Grid.Column="2"
              Command="{Binding SearchMail}"
              Style="{StaticResource FilledButtonStyle}" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Auto"
                  VerticalScrollMode="Disabled">
      <StackPanel Orientation="Horizontal"
                  Padding="12,4"
                  Spacing="8">
        <Button x:Uid="MailSearchView.Button.CurrentScope"
                Command="{Binding UseCurrentSearchScope}" />

        <StackPanel MinWidth="180"
                    Spacing="4">
          <TextBox x:Uid="MailSearchView.TextBox.Account"
                   Text="{Binding SearchAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Uid="MailSearchView.Button.ClearAccount"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchAccount}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <StackPanel MinWidth="180"
                    Spacing="4">
          <TextBox x:Uid="MailSearchView.TextBox.Folder"
                   Text="{Binding SearchFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Uid="MailSearchView.Button.ClearFolder"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchFolder}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <StackPanel MinWidth="220"
                    Spacing="4">
          <TextBox x:Uid="MailSearchView.TextBox.Sender"
                   Text="{Binding SearchSender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Uid="MailSearchView.Button.ClearSender"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchSender}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <StackPanel MinWidth="220"
                    Spacing="4">
          <TextBox x:Uid="MailSearchView.TextBox.Recipient"
                   Text="{Binding SearchRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Uid="MailSearchView.Button.ClearRecipient"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchRecipient}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <StackPanel MinWidth="220"
                    Spacing="4">
          <CalendarDatePicker x:Uid="MailSearchView.DatePicker.After"
                              Date="{Binding SearchReceivedOnOrAfter, Mode=TwoWay}" />
          <Button x:Uid="MailSearchView.Button.ClearAfter"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchReceivedOnOrAfter}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <StackPanel MinWidth="220"
                    Spacing="4">
          <CalendarDatePicker x:Uid="MailSearchView.DatePicker.Before"
                              Date="{Binding SearchReceivedBefore, Mode=TwoWay}" />
          <Button x:Uid="MailSearchView.Button.ClearBefore"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClearSearchReceivedBefore}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </StackPanel>

        <CheckBox x:Uid="MailSearchView.CheckBox.Unread"
                  MinWidth="120"
                  VerticalAlignment="Center"
                  IsThreeState="True"
                  IsChecked="{Binding SearchUnread, Mode=TwoWay}" />

        <CheckBox x:Uid="MailSearchView.CheckBox.Flagged"
                  MinWidth="120"
                  VerticalAlignment="Center"
                  IsThreeState="True"
                  IsChecked="{Binding SearchFlagged, Mode=TwoWay}" />

        <CheckBox x:Uid="MailSearchView.CheckBox.Attachments"
                  MinWidth="160"
                  VerticalAlignment="Center"
                  IsThreeState="True"
                  IsChecked="{Binding SearchHasAttachments, Mode=TwoWay}" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Auto"
                  VerticalScrollMode="Disabled">
      <ItemsControl ItemsSource="{Binding RecentSearches}"
                    Padding="12,4">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"
                        Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="search:RecentMailSearch">
            <Button Content="{x:Bind Query}"
                    Command="{utu:ItemsControlBinding Path=DataContext.RepeatSearch}"
                    CommandParameter="{x:Bind}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3"
                Padding="12,4"
                Spacing="4">
      <TextBlock Text="{Binding SearchReading.Scope}"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 Visibility="{Binding SearchReading.HasSearched, Converter={StaticResource AffirmedVisibility}}" />

      <InfoBar x:Uid="MailSearchView.InfoBar.SemanticInactive"
               IsOpen="{Binding SearchReading.SemanticSearchInactive}"
               IsClosable="False"
               Severity="Informational" />

      <InfoBar x:Uid="MailSearchView.InfoBar.SemanticDegraded"
               IsOpen="{Binding SearchReading.SemanticSearchDegraded}"
               IsClosable="False"
               Severity="Warning" />
    </StackPanel>

    <Grid Grid.Row="4">
      <ListView x:Uid="MailSearchView.List.Results"
                ItemsSource="{Binding SearchResults}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                utu:CommandExtensions.Command="{Binding OpenSearchResult}"
                Padding="4,0,4,12">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="messages:MessageRow">
            <messages:MessageRowView Row="{x:Bind}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <mvux:FeedView Source="{Binding SearchResults}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Border Height="0" />
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <ProgressBar IsIndeterminate="True"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Stretch" />
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>

        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <StackPanel Padding="16"
                        Spacing="8"
                        VerticalAlignment="Top">
              <InfoBar x:Uid="MailSearchView.InfoBar.AwaitingSearch"
                       IsOpen="{Binding Parent.SearchReading.AwaitsSearch}"
                       IsClosable="False"
                       Severity="Informational" />

              <InfoBar x:Uid="MailSearchView.InfoBar.NoResults"
                       IsOpen="{Binding Parent.SearchReading.HasSearched}"
                       IsClosable="False"
                       Severity="Informational">
                <InfoBar.ActionButton>
                  <Button x:Uid="MailSearchView.Button.Widen"
                          Command="{Binding Parent.WidenSearch}" />
                </InfoBar.ActionButton>
              </InfoBar>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>

        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <InfoBar x:Uid="MailSearchView.InfoBar.Unavailable"
                     Margin="16"
                     VerticalAlignment="Top"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Error">
              <InfoBar.ActionButton>
                <Button x:Uid="MailSearchView.Button.Retry"
                        Command="{Binding Parent.SearchMail}" />
              </InfoBar.ActionButton>
            </InfoBar>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
    </Grid>

    <StackPanel Grid.Row="5"
                Padding="12,4,12,8"
                Spacing="4">
      <InfoBar x:Uid="MailSearchView.InfoBar.PageUnavailable"
               IsOpen="{Binding SearchPagingFailed}"
               IsClosable="False"
               Severity="Warning" />

      <utu:LoadingView Source="{Binding ShowMoreSearchResults}"
                       Visibility="{Binding SearchReading.HasMore, Converter={StaticResource AffirmedVisibility}}">
        <utu:LoadingView.Content>
          <Button x:Uid="MailSearchView.Button.ShowMore"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ShowMoreSearchResults}"
                  Style="{StaticResource TextBlockButtonStyle}" />
        </utu:LoadingView.Content>
        <utu:LoadingView.LoadingContent>
          <ProgressBar IsIndeterminate="True"
                       HorizontalAlignment="Stretch" />
        </utu:LoadingView.LoadingContent>
      </utu:LoadingView>
    </StackPanel>
  </Grid>
</UserControl>
