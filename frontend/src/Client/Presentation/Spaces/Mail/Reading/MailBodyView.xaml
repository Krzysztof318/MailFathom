<UserControl x:Class="MailFathom.Client.Presentation.Spaces.Mail.Reading.MailBodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="480">

  <Grid>
    <!-- One scroller over the whole body, so a table or a code sample scrolls inside its own container rather than
         taking the pane sideways with it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16">
      <StackPanel Spacing="12">

        <!-- What the message asked to load from somebody else's server, and the reader's own answer to it. The button
             is the whole of the override: it re-reads this message with the references followed, nothing writes the
             answer down, and opening the message again asks again. -->
        <InfoBar x:Uid="MailBody.InfoBar.RemoteContent"
                 IsOpen="{x:Bind Reading.WithholdsRemoteContent, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational"
                 Message="{x:Bind Reading.WithheldRemoteContent, Mode=OneWay}">
          <InfoBar.ActionButton>
            <Button x:Uid="MailBody.Button.ShowRemoteContent"
                    Command="{x:Bind ShowRemoteContentCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind ShowRemoteContentCommandParameter, Mode=OneWay}" />
          </InfoBar.ActionButton>
        </InfoBar>

        <!-- What this reading of the message did fetch, said plainly rather than left for the reader to infer from the
             pictures appearing. -->
        <InfoBar x:Uid="MailBody.InfoBar.RemoteContentShown"
                 IsOpen="{x:Bind Reading.ShowsRemoteContent, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Warning"
                 Message="{x:Bind Reading.ShownRemoteContent, Mode=OneWay}" />

        <!-- Why this message is read as words rather than drawn. Always above the words themselves rather than in
             their place: a reader who can see the reason but not the message has lost the message. -->
        <InfoBar x:Uid="MailBody.InfoBar.PlainText"
                 IsOpen="{x:Bind Reading.HasReason, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational"
                 Message="{x:Bind Reading.Reason, Mode=OneWay}" />

        <InfoBar x:Uid="MailBody.InfoBar.Truncated"
                 IsOpen="{x:Bind Reading.WasTruncated, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational" />

        <InfoBar x:Uid="MailBody.InfoBar.UndrawnImages"
                 IsOpen="{x:Bind Reading.HasUndrawnImages, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational"
                 Message="{x:Bind Reading.UndrawnImages, Mode=OneWay}" />

        <!-- A deployment ahead of this build is ordinary rather than exceptional, since a head and a service are
             updated separately. Each block this build does not know already stands as an absence of its own; this is
             what tells the reader why there are any. -->
        <InfoBar x:Uid="MailBody.InfoBar.DeploymentAhead"
                 IsOpen="{x:Bind Reading.DeploymentAhead, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational" />

        <!-- Where the drawn document goes. Its content is computed rather than authored, because the shape of a
             message is known only when one arrives; MailBodyDrawing is what builds it. -->
        <Border x:Name="Document"
                x:Uid="MailBody.Document"
                Visibility="{x:Bind Reading.DrawsDocument, Mode=OneWay, Converter={StaticResource AffirmedVisibility}}" />

        <!-- The message as words, which is a rendering in its own right rather than a broken one. -->
        <TextBlock x:Uid="MailBody.Words"
                   Text="{x:Bind Reading.PlainText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource MailBodyParagraphStyle}"
                   Visibility="{x:Bind Reading.ShowsPlainText, Mode=OneWay, Converter={StaticResource AffirmedVisibility}}" />

      </StackPanel>
    </ScrollViewer>

    <!-- What the pane is before a message is opened in it. -->
    <TextBlock x:Uid="MailBody.Empty"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               Style="{StaticResource MailBodyUnsupportedStyle}"
               Visibility="{x:Bind Nothing, Mode=OneWay, Converter={StaticResource AffirmedVisibility}}" />

    <!-- The question asked before any link is followed. It is modal because the question is: the reader is deciding
         whether to leave the application for an address a stranger chose, and the words on the link are exactly what a
         deceptive one controls. Authored here rather than composed in code so the dialog keeps the design system's own
         template on every head. -->
    <ContentDialog x:Name="LinkQuestion" DefaultButton="Close">
      <StackPanel Spacing="4">
        <TextBlock x:Name="LinkDisplayLabel" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="LinkDisplayValue"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource MailBodyParagraphStyle}" />
        <TextBlock x:Name="LinkTargetLabel" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="LinkTargetValue"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource MailBodyPreformattedStyle}" />
        <TextBlock x:Name="LinkPunycodeLabel"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="LinkPunycodeValue"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource MailBodyPreformattedStyle}"
                   Visibility="Collapsed" />
        <InfoBar x:Name="LinkDeception"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Warning" />
      </StackPanel>
    </ContentDialog>
  </Grid>
</UserControl>
