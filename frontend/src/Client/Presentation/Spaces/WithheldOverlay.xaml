<UserControl x:Class="MailFathom.Client.Presentation.Spaces.WithheldOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MailFathom.Client.Presentation.Spaces"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400"
             Visibility="{x:Bind Withheld, Mode=OneWay, Converter={StaticResource AffirmedVisibility}}">

  <!-- Opaque rather than transparent: it stands over the space it replaces, so what it covers has to stop being
       readable through it. One set of words for all three spaces, because which space this is, is on the screen
       already; which of the two reasons withheld it is the frame's to say, above this. -->
  <Grid Background="{ThemeResource BackgroundBrush}">
    <local:SpacePlaceholder x:Uid="Workspace.Space.Withheld" />
  </Grid>
</UserControl>
