  </data>
  <data name="MailBody.InfoBar.Truncated.Message" xml:space="preserve">
    <value>Ta wiadomość jest dłuższa niż to, co tu widać.</value>
    <comment>States that a bound stopped the rendering, without claiming which one did.</comment>
  </data>
  <data name="MailBody.InfoBar.UndrawnImages.Title" xml:space="preserve">
    <value>Pominięto część obrazów</value>
    <comment>Heads the notice counting the message's own pictures that were left undrawn.</comment>
  </data>
  <data name="MailBody.InfoBar.DeploymentAhead.Title" xml:space="preserve">
    <value>Nowsza niż ta wersja</value>
