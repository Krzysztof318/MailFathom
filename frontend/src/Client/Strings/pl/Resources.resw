    <comment>What a screen reader announces the drawn document as.</comment>
  </data>
  <data name="MailBody.Words.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Treść wiadomości jako tekst</value>
