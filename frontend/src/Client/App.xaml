<Application x:Class="MailFathom.Client.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:ut="using:Uno.Themes"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:presentation="using:MailFathom.Client.Presentation">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme>
          <!-- The palette overrides Material's own colours for every key it declares, which is why no seed colour is
               set beside it: a seed generates the ramps at run time, and this application generated them once and
               wrote the result down, so the values a screen resolves are the values a reader can measure. -->
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
        </utum:MaterialToolkitTheme>

        <!-- What a message body is drawn with, merged after the design system so every style in it can be based on one
             of Material's own. It is here rather than beside the pane because the drawing is computed in C#: a style a
             page owns would be out of reach of the one place that needs it. -->
        <ResourceDictionary Source="ms-appx:///Styles/MailBodyView.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The two widths the client's composition changes at, written once and read by every adaptive trigger that
           acts on them. Below the first, navigation is a bar along the bottom over one column of workspace; at it,
           navigation becomes a rail beside the workspace; at the second, the workspace itself opens a companion
           column. They are window widths rather than platform tests, which is what makes a resized desktop window
           and a phone the same case. -->
      <x:Double x:Key="WorkspaceRailWindowWidth">700</x:Double>
      <x:Double x:Key="WorkspaceWideWindowWidth">1000</x:Double>

      <!-- What turns something the session stated into a composition — that a capability is offered, and equally that
           one is withheld. It is stated once for the whole application because every screen that follows a grant asks
           the same question of the same kind of value, and because the safe reading of an answer that has not arrived
           — collapse it — is one decision rather than one per page. -->
      <presentation:AffirmedVisibilityConverter x:Key="AffirmedVisibility" />

    </ResourceDictionary>
  </Application.Resources>

</Application>
