<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- The two heads this application is written for, and the plain target beside them. `net10.0-browserwasm` is the
         browser head and `net10.0-desktop` is the Skia desktop head, which runs on Windows, Linux, and macOS from this
         one target framework. The bare `net10.0` target builds no head at all: it is the reference target a unit-test
         project references the application through, since a test host is neither a browser nor a desktop window. The
         mobile heads are deliberately absent — adding `net10.0-android` and `net10.0-ios` here is what opens them,
         and nothing else in this project has to change for that. -->
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>MailFathom</ApplicationTitle>
    <ApplicationId>io.github.krzysztof318.mailfathom</ApplicationId>
    <!-- The display version is the one number Version.props declares, so the client and the service it talks to never
         report two. The numeric ApplicationVersion is the store build counter every mobile head demands as an integer;
         it stays at 1 until a head that publishes to a store exists to increment it. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Krzysztof Kasprowicz</ApplicationPublisher>
    <Description>The MailFathom client: a mail application with the model in the middle of it.</Description>

    <!-- The two grounds the Uno resizetizer paints behind the assets under Assets/, both the navy the product mark
         sits on. They are properties rather than anything drawn in an SVG because the resizetizer composes the icon's
         background layer and the splash's ground itself, and a colour painted in the file would be cropped or scaled
         with the drawing instead of filling what is behind it. The splash therefore looks the same whichever theme
         the application starts in: it is decided before a theme is applied and unchanged by a later one. -->
    <UnoIconBackgroundColor>#010D33</UnoIconBackgroundColor>
    <UnoSplashScreenColor>#010D33</UnoSplashScreenColor>

    <!-- The language a head falls back to when the operating system asks for one this application does not carry, and
         the one a resource lookup resolves against when nothing else answers. English rather than Polish because the
         person who has configured nothing is the one this decides for, and a first run has to be readable before any
         setting has been found. It is an IETF language tag and it names a neutral culture: `en` and `pl` are what
         Strings/ carries, and a regional variant arrives when something actually differs between regions. -->
    <DefaultLanguage>en</DefaultLanguage>

    <!-- UnoFeatures is how an Uno single project asks for a capability rather than for a package: the SDK resolves each
         one to the packages and versions its own pin decides. Material is the design system every brush and style here
         resolves against, Configuration is what reads the deployment an installed head reaches out of an embedded
         appsettings.json — the one source a browser head can read too — Localization is what resolves a string against
         the culture the person is reading in, Toolkit adds the controls the shell is built from, Hosting and Logging
         are the generic-host wiring the application starts through, MVUX is the state model, Navigation is the router,
         ThemeService is what puts the application into light or dark and remembers which,
         and SkiaRenderer is what makes one rendering path serve every head.
         https://aka.platform.uno/singleproject-features -->
    <UnoFeatures>
      Material;
      Configuration;
      Hosting;
      Localization;
      Toolkit;
      Logging;
      MVUX;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!-- The browser head alone, and for one generator rather than for any code written here. `[JSImport]` marshals its
       arguments through pointers, so the interop source generator emits unsafe code and refuses to run without this —
       SYSLIB1074 says so by name. Nothing under Platforms/WebAssembly/ contains an `unsafe` block of its own, and no
       other head compiles that directory, which is why the property is scoped to the one target framework that needs
       it rather than declared for the project. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The whole ICU data set rather than the shards the WebAssembly SDK ships by default, because the default makes
         the languages this application offers depend on the language the reader's browser is set to. Left alone, the
         SDK deploys icudt_EFIGS.dat, icudt_CJK.dat, and icudt_no_CJK.dat, writes `"globalizationMode": "sharded"` into
         the boot document, and the runtime picks one of the three from `navigator.languages`: a browser reporting
         English loads EFIGS, `CultureInfo.GetCultures` then holds no `pl` at all, and Uno's localization drops a
         culture it cannot resolve without saying so — so Polish disappears from the picker for exactly the person most
         likely to want it, on a build whose Polish string table is present and correct. It costs roughly a megabyte
         over a shard, compressed on the wire and cached, and it is what makes the offered languages the same wherever
         the client runs. The desktop head resolves cultures from the operating system and needs none of it.

         The property is named for Blazor and this is not a Blazor application, but it is the one that acts here: the
         WebAssembly SDK reads it while composing the static web assets. `WasmIncludeFullIcuData`, which the runtime
         SDK documents for the same thing, belongs to the older WasmAppBuilder bundle path that this project does not
         take, and setting it changes nothing. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- Where the service is, when whoever built this head knows and the head could not find out for itself. A browser
       head reads no process environment, so the orchestration that starts it cannot hand it an address the way it
       hands one to every other resource — but it does start the build, and what the build writes is what the browser
       downloads. A runtime host configuration option is that channel: MSBuild writes it into the runtimeconfig, the
       WebAssembly SDK carries the runtimeconfig into the boot configuration the page fetches, and the type that reads
       it back — Deployment/BuildStatedDeploymentAddress.cs — asks AppContext.GetData for this key, with no reflection
       for the trimmer to remove. That type names the key on its own side: the two names are one decision recorded in
       two files, because a project and the app model that starts it share no build file. The desktop head takes the
       same property and reads the same key out of its own runtimeconfig.json.

       Emitted only when the property carries a value, which one caller states and no publish does: the local
       orchestration's client resource, in backend/src/AppHost/Program.cs. An artifact built without it carries no
       option at all, so a head served from the container image resolves its deployment as the origin it was fetched
       from exactly as before. Trim="false" because this is an address rather
       than a feature switch — the trimmer must not read it as a constant to substitute and branch away. -->
  <ItemGroup Condition="'$(MailFathomDeploymentAddress)' != ''">
    <RuntimeHostConfigurationOption Include="MailFathom.Client.DeploymentAddress"
                                    Value="$(MailFathomDeploymentAddress)"
                                    Trim="false" />
  </ItemGroup>

  <!-- The bootstrapper deploys and loads what it finds embedded under WasmScripts, but the Uno SDK only ever adds one
       file there by itself: Uno.SingleProject.Wasm.targets includes AppManifest.js by name and globs nothing. A second
       script therefore has to be named here, or it stays an ordinary None item, never reaches the bundle, and the
       functions it defines are simply absent at run time — with the failure arriving as a JavaScript name the interop
       cannot resolve rather than as anything the build said. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <None Remove="Platforms/WebAssembly/WasmScripts/*.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/*.js"
                      Exclude="Platforms/WebAssembly/WasmScripts/AppManifest.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything that talks to the service, in an assembly that cannot reference a XAML type. The reference goes
         this way and only this way: Client.Backend knows nothing about a view, and the compiler is what says so. -->
    <ProjectReference Include="..\Client.Backend\Client.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything this project publishes is internal to it: nothing outside the application composes a head. The unit
         suite is the one exception, on the same terms Client.Backend grants it. -->
    <InternalsVisibleTo Include="MailFathom.Client.UnitTests" />
  </ItemGroup>

  <!-- What a distributed desktop head has to carry, attached to the publish rather than to the workflow that
       publishes: the project's own Apache-2.0 grant and attribution, and the notices for the one component here whose
       licence obliges them. A `net10.0-desktop` graph carries LibVLCSharp.dll, which is LGPL-2.1-or-later — see
       THIRD_PARTY_LICENSES.md and the four build properties frontend/src/AGENTS.md leaves unset for it — and section 6
       of that licence wants the statement, the licence text, and access to the corresponding source travelling with
       the artifact. Written here so that every publish of this head satisfies it, including one a contributor runs.
       The browser head resolves none of that graph and is served from the container image, whose own LICENSE and
       NOTICE the service publishes beside its assemblies. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <None Include="$(RepositoryRoot)LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(RepositoryRoot)NOTICE" Link="NOTICE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Notices/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Notices/LGPL-2.1.txt" Link="LGPL-2.1.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A missing source file makes the items above resolve to nothing and the publish silently succeeds, which is the
       one failure this has to rule out: an artifact that ships without the notices it owes is the defect, not a build
       that stops. The same target `Host` carries, over four files rather than two. -->
  <Target Name="VerifyPublishedDesktopNotices" AfterTargets="Publish" Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <Error Condition="!Exists('$(PublishDir)LICENSE')"
           Text="The published desktop head has no LICENSE. Restore the repository root LICENSE before publishing." />
    <Error Condition="!Exists('$(PublishDir)NOTICE')"
           Text="The published desktop head has no NOTICE. Restore the repository root NOTICE before publishing." />
    <Error Condition="!Exists('$(PublishDir)THIRD-PARTY-NOTICES.md')"
           Text="The published desktop head has no THIRD-PARTY-NOTICES.md, which is what states that LibVLCSharp is used under the LGPL and where its source is." />
    <Error Condition="!Exists('$(PublishDir)LGPL-2.1.txt')"
           Text="The published desktop head has no LGPL-2.1.txt, which section 6 of that licence requires the artifact to carry." />
  </Target>
</Project>
