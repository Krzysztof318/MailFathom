<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- What a message body is drawn with. It is a dictionary rather than a page's own resources because the drawing is
       computed in C# — the shape of a message is known only at run time — and this is what keeps the decision that a
       colour, a face, and a size are the design system's rather than the sender's in XAML where it can be read. Every
       brush below resolves from Styles/ColorPaletteOverride.xaml through Material's own keys, so a message drawn here
       follows the system theme exactly as the rest of the client does.

       Nothing a message says reaches any of these values. What a sender may colour is its own text and its own table
       cells, and those arrive as a colour the deployment already reduced to #rrggbb and are applied to that element
       alone. -->

  <!-- The gap between two blocks of one message, stated once so a quotation, a list item, and a table cell space their
       contents the same way the body does. -->
  <x:Double x:Key="MailBodyBlockSpacing">8</x:Double>

  <!-- What a message's fixed-width text is drawn in. Named here rather than in the drawing so the one place a face is
       chosen is a resource dictionary, and so a head whose platform lacks this family falls back to the system default
       rather than to whatever the sender asked for. -->
  <FontFamily x:Key="MailBodyMonospaceFontFamily">Consolas</FontFamily>

  <Style x:Key="MailBodyParagraphStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <!-- Six levels drawn with the pane's own typography rather than with the size the sender asked for. What carries the
       structure to somebody who is not looking at it is the heading level stated on the automation peer, which the
       drawing sets; these decide only how the words look. -->
  <Style x:Key="MailBodyHeading1Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource TitleLargeTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="MailBodyHeading2Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="MailBodyHeading3Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="MailBodyHeading4Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource MailBodyHeading3Style}" />

  <Style x:Key="MailBodyHeading5Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource MailBodyHeading3Style}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="MailBodyHeading6Style"
         TargetType="TextBlock"
         BasedOn="{StaticResource MailBodyHeading5Style}" />

  <!-- Whitespace is part of what this says, so it is never re-wrapped; the drawing puts it in a scroller of its own
       instead. -->
  <Style x:Key="MailBodyPreformattedStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontFamily" Value="{StaticResource MailBodyMonospaceFontFamily}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <!-- What stands where a part of the message is one this build cannot draw, and where a picture could not be drawn at
       all. Muted rather than alarming: it is an absence rather than a fault of the message. -->
  <Style x:Key="MailBodyUnsupportedStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Quoted history, marked by a rule down its side rather than by indenting it further each time: three replies of
       history would otherwise walk off the pane. -->
  <Style x:Key="MailBodyQuoteStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="12,0,0,0" />
  </Style>

  <Style x:Key="MailBodySeparatorStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="MailBodyTableCellStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style x:Key="MailBodyTableHeaderCellStyle"
         TargetType="Border"
         BasedOn="{StaticResource MailBodyTableCellStyle}">
    <Setter Property="Background" Value="{ThemeResource SecondaryContainerBrush}" />
  </Style>

</ResourceDictionary>
