<Project>
  <!-- The build contract for the client stack, and for nothing else. It sits here rather than at the repository root
       for the reason backend/Directory.Build.props does: MSBuild walks up from a project directory until it finds a
       Directory.Build.props, so one file above both stacks would govern an Uno head with properties decided for a
       service. The version is the one property the two stacks have to agree on, so it is imported from the root
       rather than declared here — see Version.props. -->
  <Import Project="$(MSBuildThisFileDirectory)../Version.props" />

  <!-- The same licensing and attribution the backend declares, stated again because nothing is shared between the two
       stacks' build files. The root LICENSE and NOTICE remain the authority; these are their machine-readable form in
       what actually ships. -->
  <PropertyGroup>
    <Product>MailFathom</Product>
    <Authors>Krzysztof Kasprowicz</Authors>
    <Company>Krzysztof Kasprowicz</Company>
    <Copyright>Copyright © 2026 Krzysztof Kasprowicz</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Krzysztof318/MailFathom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Krzysztof318/MailFathom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SPDX-License-Identifier" Value="Apache-2.0" />
  </ItemGroup>

  <!-- No TargetFramework is set here. A client project declares its own heads, because the set of them is the whole
       point of the project file, and a default stated up here would be one an Uno single project immediately
       overrides. -->
  <PropertyGroup>
    <AssemblyName>MailFathom.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>MailFathom.$(MSBuildProjectName)</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The API reference the documentation site publishes is generated from these comments, and IDE0005 — the rule
         that reports a using directive nothing needs — is only reported on build when the documentation file is
         written. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- NU1507 is the multi-source warning central package management raises, and the repository's NuGet.config
         declares exactly one source, so it never applies here. NETSDK1201 says a runtime identifier does not imply a
         self-contained publish, which is what an Uno head wants. PRI257 reports that `en` is not among the packaged
         resource languages, which is true of a scaffold whose only string table is the neutral one. -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
  </PropertyGroup>

  <!-- The browser head publishes trimmed, and the trimmer reports on every assembly in the graph rather than on the
       ones this repository wrote. Uno.UI, the navigation router, and the Toolkit each raise warnings that only their
       own authors can fix, and TreatWarningsAsErrors would otherwise reach the trimmer and fail the publish for them:
       IL2104 per assembly, then NETSDK1144 for the run. Trim warnings therefore stay warnings, and a warning about
       code written here is answered where it is raised — with a justified suppression naming why the reflection it
       reports is rooted, as App.OnLaunched does. -->
  <PropertyGroup>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The analyzer set the backend runs, minus three things this stack has no use for. `AnalysisMode` stays at the
       SDK default rather than `AllEnabledByDefault`, because the opt-in rules are written for a library surface and a
       server's I/O; Microsoft.VisualStudio.Threading.Analyzers is absent, because WinUI's own contract is
       `async void` on a lifecycle override and VSTHRD100 would refuse the framework rather than a defect; and
       Roslynator.CodeAnalysis.Analyzers is absent because its rules are about code that calls the Roslyn APIs, which
       is a thing no client project here does. Everything that remains applies as written: the XAML compiler and the
       MVUX generator mark their output generated, so no rule here has an opinion about code nobody wrote. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Directory.Packages.props pins the direct versions; the committed packages.lock.json records the transitive
       closure those versions and the Uno SDK's implicit packages resolve to, so a dependency move shows in the diff
       rather than only in a restore. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</RepositoryRoot>
  </PropertyGroup>

  <!-- The banned-symbol list is repository policy rather than a backend one: an ambient clock and a blocking sleep are
       as wrong in a view model as in a worker, and the client calls the same HTTP surface the trimmer refuses. -->
  <ItemGroup>
    <AdditionalFiles Include="$(RepositoryRoot).config/BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup>
    <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('.UnitTests'))">true</IsUnitTestProject>
  </PropertyGroup>

  <!-- The runner, the collector, and the coverage configuration the backend suites use, so one `dotnet test` contract
       covers the repository rather than one per stack. Microsoft Testing Platform reads the collector configuration
       from beside the test executable, so the link name rather than the source path is what has to stay
       `testconfig.json`. -->
  <PropertyGroup Condition="'$(IsUnitTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
    <!-- Exit code 8 is what the platform reports when a run discovers no test, which is what carries a test project
         from the commit that creates it to the commit that fills it. The backend's own suites ignore it for the same
         reason. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
    <!-- Test names use underscores to encode the member, scenario, and expected behavior. -->
    <NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsUnitTestProject)' == 'true'">
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <None Include="$(RepositoryRoot).config/testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
