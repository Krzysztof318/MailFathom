# The YAML form of 10-mailfathom.json.example beside it, holding the same settings. Copy exactly one of the two — this
# one as `10-mailfathom.yaml` beside this file — because two names differing only by extension stop the host. The
# extension decides how a file is read: MailFathom layers in `*.json`, `*.yaml`, and `*.yml`, so this example and a
# `.bak` are ignored. Files are layered in file-name order whatever their format, so `20-…` overrides `10-…`.
#
# The JSON example carries the reasoning behind every block below, and it holds here unchanged: every credential is a
# `file:` reference to something dropped into ./secrets/mailfathom/, and the database is configured by compose.yaml's
# environment block rather than here.
#
# A value is read as the text written: `no` stays the word no rather than becoming false, and `0x10` stays that text.
# Anchors, aliases, tags, several documents in one file, and a key written twice are refused, naming the file and the
# line. docs/operations/configuration-sources.md says why.

# Uncomment when a recorded account authenticates with OAuth. The material is `openssl rand -base64 32`.
#
# DataEncryption:
#   ActiveKeyId: "2026-08"
#   Keys:
#     - KeyId: "2026-08"
#       Material:
#         Name: mailfathom-data-key
#         SecretReference: file:/etc/mailfathom/secrets/mailfathom-data-key

# No mailbox is declared here: every account is a record, created with `mfctl account add --from-file mailbox.json`
# once the deployment is running, and `mfctl account edit --format yaml` shows one for editing in this format.
MailSynchronization:
  Enabled: true
  Interval: "00:05:00"

# How the mailbox is recorded. Port 8090 is the one compose.yaml publishes, on loopback.
AdminEndpoint:
  Enabled: true
  Port: 8090
  Authentication:
    - ApiKey:
        Name: admin
        SecretReference: file:/etc/mailfathom/secrets/admin-api-key

# Uncomment beside MAILFATHOM_CLIENT=true in .env to serve MailFathom's own client, and provision a password credential
# with `mfctl credential create --method password --username <name>`.
#
# ClientEndpoint:
#   Enabled: true
#   Authentication:
#     - Method: password
#   Cors:
#     AllowedOrigins: []

McpEndpoint:
  Enabled: true
  Authentication:
    - Method: api-key
  Cors:
    AllowedOrigins: []
