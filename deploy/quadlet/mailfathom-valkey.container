# Project repository: https://github.com/Krzysztof318/MailFathom

# The RESP server a client signal crosses from the instance that raised it to the instances holding the connections that
# have to hear about it. It is optional in the way the analyzer, the scanner, and the object store are: Quadlet has no
# equivalent of Compose's profiles, so an operator who wants none of this copies the other files and never this one — and
# then no image is pulled, no container exists, and none of the memory below is held. Installing it is half of the
# arrangement; the other half is the SignalBackplane lines in mailfathom.container, and either one alone is a deployment
# that does not work. docs/operations/deployment-quadlet.md states the order and the one password that goes between them.
#
# **On one host it does nothing, and that is the expected state rather than a misconfiguration.** This directory runs one
# MailFathom, so every signal already reaches every client connection the deployment holds and the server relays each one
# back to the single subscriber that published it. It is here so that this shape offers the same component the Helm chart
# does, and so that a deployment which grows a second instance has the piece provisioned before it needs one. Running
# more than one MailFathom under Quadlet is not supported today; issue #1295 decides whether it will be.
#
# Rootless, like the units beside it, and installed under ~/.config/containers/systemd/.

[Unit]
Description=Signal backplane for MailFathom
Wants=network-online.target
After=network-online.target

[Container]
# A digest rather than a tag, and the same pin the Compose deployment and the Helm chart carry — Valkey 9.1.2 — so the
# server this starts is the server the other two shapes start. Valkey publishes its release tags beside moving `9`,
# `9.1`, and `latest` ones, so a digest is the only reference that names one artifact. Valkey is a BSD-3-Clause RESP
# server maintained under the Linux Foundation; THIRD_PARTY_LICENSES.md records the reading, including the base image it
# is built on. Any RESP endpoint answers the same protocol — Redis, Garnet, Valkey, or a managed equivalent — which is
# what makes pointing mailfathom.container at one you already operate the other supported shape, and then no unit is
# installed here at all.
Image=docker.io/valkey/valkey@sha256:c123e3715db63d06d4ad6964884037aa0d5d4d703939b9929954112889708e1d
ContainerName=mailfathom-valkey

# Only the internal network, and no PublishPort= at all. What crosses this server is which mailbox changed and for whom,
# which is personal data on its own, so it is reachable from MailFathom and from nothing outside the host — exactly as
# the database is.
Network=mailfathom-backend.network

# The credential systemd decrypted for this unit. `%d` is $CREDENTIALS_DIRECTORY, which exists only because the [Service]
# section below asked for one; the `Z` is what gives the file an SELinux label a container may read, and
# docs/operations/deployment-quadlet.md states what happens on a host where that relabel is refused.
Volume=%d:/etc/valkey/credentials:ro,Z

# The invoking user is uid 999 inside this container, for the reason mailfathom.container states its own number: the
# image runs the server as its own unprivileged `valkey` account, which under the default rootless mapping would be a
# subordinate uid belonging to nobody — and the credential below is readable by the unit's user alone. It is 999 rather
# than MailFathom's 1654 because it is this image's account rather than the .NET base's.
UserNS=keep-id:uid=999,gid=999

# **The password arrives as a file, which on this server means an ACL file.** This is the one place this deployment
# differs from the chart, which expands the password into `--requirepass` from a Secret the kubelet reads. Nothing here
# has that expansion: podman passes these arguments through unchanged, so that route would put the password in this unit
# file, in `podman inspect`, and in this host's process list rather than in the credential store beside every other
# secret. `--aclfile` is the one way Valkey reads a credential from a path, so the credential above carries a single ACL
# line with the password inside it. The default user is what a RESP client authenticating with a password alone becomes,
# and this server holds nothing but subscriptions, so it is granted every key, every channel, and every command rather
# than a subset nobody could enumerate from the client library's own handshake.
#
# Persistence is switched off on the same line rather than left at a default: this server snapshots on a schedule unless
# `--save` is given nothing to do, and appending is already off.
Exec=--aclfile /etc/valkey/credentials/valkey-acl --save "" --appendonly no

# No volume and nothing to persist. A backplane holds a live subscription rather than a record: a restart loses nothing,
# and a server that kept anything across one would replay a statement whose subject has already moved.

# No health check, and therefore no Notify=healthy and no ordering in mailfathom.container. A check would have to
# authenticate, which would put the password in a second place — and nothing has to wait for it either: MailFathom
# finishes starting whether or not the endpoint answers, which is what lets an instance whose backplane is down keep
# serving every screen correctly from its own connections.

# Two writable paths on an otherwise read-only root filesystem, which is what the chart's pod gives this image as well:
# the runtime's scratch directory, and the working directory the server insists on whether or not it ever writes a file
# into it. In memory rather than on disk so that nothing derived from a signal outlives the container.
ReadOnly=true
Tmpfs=/tmp:mode=1777,size=64m
Tmpfs=/data:mode=1777,size=16m
DropCapability=all
NoNewPrivileges=true

LogDriver=journald

# Core dumps off, like every other container here. This one holds the ACL password in memory, which is the same reason
# docs/operations/secret-provisioning.md gives for the units that hold credentials.
Ulimit=core=0

# No AutoUpdate=. The image is pinned to a digest, and moving it is a decision rather than something that happens on its
# own; docs/operations/deployment-quadlet.md states the order an upgrade takes.

[Service]
# Decrypted by systemd as the unit starts, from a file that is ciphertext at rest and bound to this machine, produced
# with `systemd-creds --user encrypt`. It names an absolute path rather than a bare credential name: a bare name is
# looked up in the credential store and a miss is *not* fatal, which here would start a RESP server with no ACL file and
# no authentication at all.
LoadCredentialEncrypted=valkey-acl:%h/.config/credstore.encrypted/valkey-acl

# Bound the in-memory exposure that no code-level measure addresses, for the process that decrypts the ACL password
# before handing it on.
LimitCORE=0

# The unit-level bounds. No key is ever written to this server, so what the limit covers is the process and its
# allocator's arenas rather than anything this deployment stores — and with persistence off it never covers a fork
# copying a dataset either.
MemoryMax=256M
CPUQuota=100%

Restart=always

[Install]
WantedBy=default.target
