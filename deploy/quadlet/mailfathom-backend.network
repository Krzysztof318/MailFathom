# What the database is reachable on, and nothing that is not on it reaches the database. This is the same boundary
# deploy/compose/compose.yaml draws with its own `backend`: `Internal=true` leaves the network without a route out of
# the host, so a container attached only to this one can talk to PostgreSQL and to nothing else.
#
# MailFathom is attached to this network *and* to mailfathom-frontend.network, because it has to reach IMAP servers and
# whichever model provider it is configured against. PostgreSQL is attached to this one alone.

[Unit]
Description=The MailFathom database network

[Network]
NetworkName=mailfathom-backend
Internal=true
