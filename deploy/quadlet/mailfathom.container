# MailFathom itself, started from a systemd unit source so that the credentials the native installation uses are
# reachable from a container. docs/operations/deployment-quadlet.md is the guide: what to copy where, how the
# credentials are produced, what SELinux costs, and when to choose this shape over deploy/compose/compose.yaml.
#
# This file applies no database schema and contains nothing that can. MailFathom never applies a schema change while
# starting — it verifies the schema and refuses to serve against one it does not recognize — so starting the unit after
# a version change tells you whether a migration is outstanding rather than silently applying one.

[Unit]
Description=MailFathom
Wants=network-online.target
After=network-online.target

# A real dependency rather than Compose's approximation of one. mailfathom-postgres.container declares `Notify=healthy`,
# so this unit is ordered after a database that answers rather than after a container that has been created, and
# `Requires=` propagates a stop: a database that is taken down takes MailFathom with it instead of leaving it retrying
# against nothing.
Requires=mailfathom-postgres.service
After=mailfathom-postgres.service

# Only when personal-data scanning is on, and uncommented together with the four Environment= lines further down and
# mailfathom-presidio.container being installed at all. The analyzer unit declares `Notify=healthy` as well, so this
# ordering waits for an analyzer that answers rather than for a container that exists. Nothing breaks without it —
# MailFathom starts either way and reports unready until the analyzer answers — but the analyzer loads a language model
# before it serves anything, and ordering the two keeps that interval off the application's readiness probe.
#Requires=mailfathom-presidio.service
#After=mailfathom-presidio.service

# Only when spam classification is on with a scanner, and uncommented together with the Environment= lines further down
# and mailfathom-spamassassin.container being installed at all. That unit declares `Notify=healthy` as well, so this
# ordering waits for a daemon that answers rather than for a container that exists — which matters here for the reason
# it does for the analyzer: the daemon fetches its rule updates and compiles its corpus before it listens, and
# MailFathom refuses to start while it cannot reach one.
#Requires=mailfathom-spamassassin.service
#After=mailfathom-spamassassin.service

# At least one file MailFathom will actually read, which is a narrower thing than the directory existing. Podman
# creates a missing bind source as an empty directory rather than refusing, the setup creates that directory in a step
# of its own, and MailFathom layers in `*.json` and nothing else — so a directory that is absent, empty, or holds only
# the tracked `.json.example` all produce the same start: synchronization off, no account, no MCP endpoint, and nothing
# saying why. The glob covers all three and couples to no particular file name, so a deployment that splits its
# configuration across `10-` and `20-` files satisfies it unchanged.
AssertPathExistsGlob=%h/.config/mailfathom/config/*.json

[Container]
# There is no default version here, deliberately, and the placeholder is invalid on purpose: an unedited unit fails
# with an unparseable image reference rather than pulling whatever a moving tag points at today. Replace <version> with
# the release you are installing — `ghcr.io/krzysztof318/mailfathom` and `docker.io/krzysztof318/mailfathom` are the
# same digest, so the registry is a question about your environment. Never a moving tag, and never a nightly
# identifier; ADR 0004 defines the channels.
Image=ghcr.io/krzysztof318/mailfathom:<version>
ContainerName=mailfathom

# Both networks. The internal one is how the database is reached; the other is how the mail servers and the configured
# model provider are, and it is where a reverse proxy terminating TLS in front of MailFathom is attached.
Network=mailfathom-backend.network
Network=mailfathom-frontend.network

# Bound to loopback by default. MailFathom speaks plain HTTP and terminates no TLS of its own, so publishing the
# application port on another interface exposes synchronized mail without transport protection. Change the address only
# once a reverse proxy is what listens publicly. Rootless Podman publishes no port below 1024 until
# net.ipv4.ip_unprivileged_port_start allows it, which is a limit met by that proxy rather than by MailFathom.
PublishPort=127.0.0.1:8080:8080
# The probes, on a listener of their own. They answer without a credential, so which address their port is published on
# is what controls who can ask them. A probe path asked on 8080 is answered with 404, and so is /mcp asked on 8081.
PublishPort=127.0.0.1:8081:8081

# The invoking user is uid 1654 — the image's own unprivileged account — inside this container. That is what makes the
# credentials directory below readable: systemd restricts it to the unit's user, and under the default rootless mapping
# uid 1654 would be a subordinate uid belonging to nobody. It also removes the file-mode arrangement the Compose
# deployment needs, where the mounted directories and files have to be traversable and readable by an account that is
# nobody's host user; here they are simply yours.
UserNS=keep-id:uid=1654,gid=1654

# Ordinary configuration, layered under the environment block below. See docs/operations/configuration-sources.md for
# the precedence and for what a directory contributes; deploy/quadlet/config/10-mailfathom.json.example in the
# repository is what the operator copies here.
Volume=%h/.config/mailfathom/config:/etc/mailfathom/config:ro,Z

# The credentials systemd decrypted for this unit. `%d` is $CREDENTIALS_DIRECTORY on the host, which exists only
# because the [Service] section below asked for credentials, and the `Z` is what gives those files an SELinux label a
# container may read — docs/operations/deployment-quadlet.md states what happens on a host where that relabel is
# refused, and what the alternative costs.
Volume=%d:/etc/mailfathom/credentials:ro,Z

Environment=ASPNETCORE_ENVIRONMENT=Production

# systemd exports $CREDENTIALS_DIRECTORY to the process it starts, which here is podman rather than MailFathom, and
# podman forwards nothing of its own environment. So the variable is restated for the container, pointing at the mount
# above: `systemd-credential:` references then resolve inside the container exactly as they do for the native service.
Environment=CREDENTIALS_DIRECTORY=/etc/mailfathom/credentials

# The MCP endpoint's own port. MailFathom refuses ASPNETCORE_HTTP_PORTS: each surface states where it is served in its
# own configuration section.
Environment=McpEndpoint__Port=8080
Environment=ConfigurationSources__Directory=/etc/mailfathom/config

# Composed here from parts that are not secret, so the password stays a credential: only it arrives through
# Persistence__Password, as a reference systemd resolved.
Environment=ConnectionStrings__mailfathom=Host=mailfathom-postgres;Port=5432;Database=mailfathom;Username=mailfathom
Environment=Persistence__Password__Name=mailfathom-database-password
Environment=Persistence__Password__SecretReference=systemd-credential:mailfathom-database-password

# Personal-data scanning, off because these four lines are commented out — which is the product's default and what makes
# it cost nothing. Uncomment them together with the two ordering lines at the top of this file, and install
# mailfathom-presidio.container beside it; enabling the switch with no address at all fails startup and names the
# Endpoint setting below as the one to correct, while an address nothing answers at leaves the unit running and unready,
# both of which are the intended behaviour rather than a misconfiguration to avoid.
# The address is the analyzer unit's container name on the internal network — replace it with your own analyzer's if you
# operate one, keeping it inside your own network, and then install no analyzer unit at all.
# docs/features/sensitive-content-scanning.md states what each category hides and what pointing the endpoint outside the
# deployment gives up.
# The language is one per deployment and the analyzer image below has to have been built for it: the pinned image carries
# an English model and an English recognizer registry, so naming another code here leaves the unit unready rather than
# scanning in that language. docs/operations/personal-data-analyzer-languages.md states what a second language takes and
# which identifiers each language reaches.
#Environment=SensitiveContent__Pii__Enabled=true
#Environment=SensitiveContent__PersonalDataAnalyzer__Endpoint=http://mailfathom-presidio:3000
#Environment=SensitiveContent__PersonalDataAnalyzer__Language=en
#Environment=SensitiveContent__PersonalDataAnalyzer__MinimumConfidence=0.4

# Spam classification with a scanner, off because these lines are commented out. Uncomment them together with the two
# ordering lines at the top of this file, and install mailfathom-spamassassin.container beside it; enabling the switch
# with no daemon to reach fails startup and names the Host setting below as the one to correct, which is the intended
# behaviour rather than a misconfiguration to avoid. Both switches are here because MailFathom refuses to start with a
# scanner switched on and classification off. The address is the scanner unit's container name on the internal network —
# replace it with your own daemon's if you operate one, keeping it inside your own network, and then install no scanner
# unit at all.
#
# Classification **without** a scanner is the other half of the feature: set SpamClassification__Enabled=true alone, and
# mail is classified from the headers it already carries with nothing else deployed. Which folders are covered and what
# threshold a score is judged by belong in the configuration directory beside this unit, not here.
# docs/features/spam-classification.md states what each stage decides and what pointing the scanner outside the
# deployment gives up.
#Environment=SpamClassification__Enabled=true
#Environment=SpamClassification__UseScanner=true
#Environment=SpamClassification__Scanner__Host=mailfathom-spamassassin
#Environment=SpamClassification__Scanner__Port=783

# The same posture the image and the other two deployment shapes carry: nothing writable but one bounded tmpfs, no
# capabilities, and no way to gain a privilege. /tmp is the one path the runtime needs to write.
ReadOnly=true
Tmpfs=/tmp:mode=1777,size=64m
DropCapability=all
NoNewPrivileges=true

# No health check. The image declares none — it carries no shell and no HTTP client for one to run in — and one written
# here would need the same thing inside the container. The probes are asked from outside instead, on the port published
# above; docs/operations/health-endpoints.md states what each one answers.

LogDriver=journald

# Core dumps off inside the container as well as around it, which is the operational control
# docs/operations/secret-provisioning.md names for secret material a process holds in memory.
Ulimit=core=0

# Longer than the host's own shutdown budget, which is derived from MailSynchronization:ShutdownDrainTimeout, so the
# process finishes draining and exits rather than being killed mid-run.
StopTimeout=60

# No AutoUpdate=. An upgrade here is a decision with a schema step in front of it, so nothing moves the image on its
# own; docs/operations/deployment-quadlet.md states the order.

[Service]
# One line per credential the configuration names, which is the grant: this unit reaches exactly these and nothing else
# under ~/.config/credstore.encrypted/. Add a line when you add an account, and remove one when the account goes.
#
# Each names an absolute path rather than a bare credential name. A bare name is looked up in the credential store and
# a miss is *not* fatal, so a typo would start the service with the credential silently absent; an absolute path that
# does not exist fails the unit with the path in the message.
#
# The files are produced by `systemd-creds --user encrypt`, and a per-user service manager can decrypt one only since
# systemd 258. docs/operations/deployment-quadlet.md states what an older systemd leaves available and what it gives up.
LoadCredentialEncrypted=mailfathom-database-password:%h/.config/credstore.encrypted/mailfathom-database-password
LoadCredentialEncrypted=imap-primary-password:%h/.config/credstore.encrypted/imap-primary-password
LoadCredentialEncrypted=mcp-workstation-key:%h/.config/credstore.encrypted/mcp-workstation-key
# Only when a mailbox authenticates with OAuth. See config/10-mailfathom.json.example.
#LoadCredentialEncrypted=mailfathom-data-key:%h/.config/credstore.encrypted/mailfathom-data-key

# Bound the in-memory exposure that no code-level measure addresses, for the process that decrypts every credential
# above before handing it on.
LimitCORE=0

# The unit-level bounds this shape has and the Compose deployment approximates with `deploy.resources`.
MemoryMax=1G
CPUQuota=200%

Restart=always
# Above StopTimeout, so podman is the one that stops the container rather than systemd killing podman while it tries.
TimeoutStopSec=90

[Install]
WantedBy=default.target
