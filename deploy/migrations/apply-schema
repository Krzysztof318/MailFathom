#!/usr/bin/env bash
set -euo pipefail

# The entrypoint of the MailMcp migration image.
#
# It applies the idempotent schema script generated from the migrations this build was compiled against, and it does
# nothing else. The service image contains neither this script nor the SQL, so "the host never applies migrations" is a
# property of what was built rather than a rule at run time.
#
# The script is idempotent: it consults `__EFMigrationsHistory` and applies only what is missing, so running it against
# an up-to-date database is a no-op rather than an error. It brings its own `START TRANSACTION` and `COMMIT` around
# each migration, which is why psql is not asked to wrap the file in a second one — a nested transaction would only
# make the boundaries EF chose invisible. `ON_ERROR_STOP` is what stops the file at the first failing statement, so a
# migration that fails half-way rolls back rather than leaving a schema nothing describes.

readonly schema_script='/schema/mailmcp-schema.sql'

usage() {
  cat <<'USAGE'
Usage:
  apply-schema [--apply]     Apply the schema. This is the default when no argument is given.
  apply-schema --print       Write the SQL to standard output and exit. Connects to nothing.
  apply-schema --help

Connection, in the order this script looks for one:

  MAILMCP_MIGRATION_DSN_FILE   A file holding a libpq connection string or URI. Preferred: a mounted secret is the
                               shape docs/operations/secret-provisioning.md asks every credential to arrive in, and a
                               file never appears in another process's environment block or in `ps`.
  MAILMCP_MIGRATION_DSN        The same value, inline. Convenient for a one-shot local run, and readable by anything
                               that can read this container's environment.
  PGHOST / PGPORT / PGDATABASE / PGUSER, plus one of:
  MAILMCP_MIGRATION_PASSWORD_FILE  A file holding only the password.
  PGPASSWORD                       The password, inline, with the same caveat as MAILMCP_MIGRATION_DSN.

libpq reads PGSSLMODE, PGSSLROOTCERT, and its other TLS variables directly, so a verified connection needs no setting
of ours.

  MAILMCP_RUNTIME_ROLE         The role MailMcp itself connects as, when that is not the role applying this schema.
                               PostgreSQL makes whoever runs the DDL the owner of what it creates, and ownership
                               grants nothing to anybody else, so a split without this leaves the Job succeeding and
                               the service failing on permissions afterwards. Naming the role grants it the DML
                               privileges it needs, here and for whatever a later migration adds.

The role this connects as needs more privilege than the service's own: the schema creates the `vector` extension,
which PostgreSQL does not permit an ordinary role to install. That asymmetry is the point of a separate, explicitly
invoked step — grant the service a role that can read and write rows and nothing more.
USAGE
}

fail() {
  printf 'apply-schema: %s\n' "$1" >&2
  exit 1
}

# Reads material the deployment provisioned as a file, stripping exactly one trailing newline. `LoadCredential=`,
# Compose secrets, and Kubernetes Secret files routinely end with one, and an untrimmed byte presents as a wrong
# password. MailMcp's own secret resolution strips one and only one for the same reason.
#
# The `x` sentinel is what makes "exactly one" true. Command substitution strips *every* trailing newline, so a
# credential that genuinely ends in two would lose both here and one in MailMcp, and the two would authenticate
# differently. Appending a byte the substitution cannot strip, then removing that byte, preserves the material as it
# was written; only the explicit `%$'\n'` below takes a newline off.
read_provisioned_file() {
  local path="$1"
  local setting_name="$2"

  [[ -r "$path" ]] || fail "${setting_name} names ${path}, which this container cannot read."

  local material
  material="$(cat -- "$path"; printf 'x')"
  material="${material%x}"

  printf '%s' "${material%$'\n'}"
}

# Set by resolve_connection, and empty when libpq is left to read the PG* variables itself.
resolved_connection=''

# Assigns to the two globals above rather than writing the connection to standard output, because part of what it
# resolves is an exported PGPASSWORD — and an export inside a command substitution is made in a subshell that ends
# before psql is ever invoked. Reading its result through `$(...)` would silently drop the password.
resolve_connection() {
  resolved_connection=''

  if [[ -n "${MAILMCP_MIGRATION_DSN_FILE:-}" ]]; then
    resolved_connection="$(read_provisioned_file "$MAILMCP_MIGRATION_DSN_FILE" 'MAILMCP_MIGRATION_DSN_FILE')"
    return
  fi

  if [[ -n "${MAILMCP_MIGRATION_DSN:-}" ]]; then
    resolved_connection="$MAILMCP_MIGRATION_DSN"
    return
  fi

  [[ -n "${PGHOST:-}" ]] || fail 'no connection is configured; set MAILMCP_MIGRATION_DSN_FILE, MAILMCP_MIGRATION_DSN, or the PG* variables. Run with --help for the full list.'

  if [[ -n "${MAILMCP_MIGRATION_PASSWORD_FILE:-}" ]]; then
    PGPASSWORD="$(read_provisioned_file "$MAILMCP_MIGRATION_PASSWORD_FILE" 'MAILMCP_MIGRATION_PASSWORD_FILE')"
    export PGPASSWORD
  fi
}

apply_schema() {
  resolve_connection

  # `--no-psqlrc` because a mounted home directory must not decide how a schema change runs, and `--quiet` so the
  # output is the migration's own rather than a banner. Nothing here echoes the connection string: it can carry the
  # password.
  printf 'apply-schema: applying %s\n' "$schema_script"

  if [[ -n "$resolved_connection" ]]; then
    psql --no-psqlrc --quiet --set ON_ERROR_STOP=1 --file "$schema_script" -- "$resolved_connection"
  else
    psql --no-psqlrc --quiet --set ON_ERROR_STOP=1 --file "$schema_script"
  fi

  grant_the_runtime_role_access

  printf 'apply-schema: done.\n'
}

# Gives the service's role the privileges it needs on what the migration just created, and nothing more.
#
# It exists because the least-privilege split has a consequence that is easy to miss: PostgreSQL makes the role that
# runs the DDL the owner of every table, sequence, and index it creates, and ownership grants nothing to anybody else.
# A deployment that gives the migration its own more privileged role would therefore watch the Job succeed and then
# watch MailMcp fail on permission errors against a schema that exists.
#
# Grants rather than a transfer of ownership, deliberately. Handing the tables to the runtime role would leave the
# migrator unable to alter them on the next migration without being a member of that role or a superuser, which is the
# privilege the split exists to avoid. `ALTER DEFAULT PRIVILEGES` then covers what future migrations create, so this
# does not have to be remembered again.
#
# Skipped entirely when the two roles are the same, which is the ordinary case: an owner already has everything.
grant_the_runtime_role_access() {
  [[ -n "${MAILMCP_RUNTIME_ROLE:-}" ]] || return 0

  printf 'apply-schema: granting %s access to the migrated objects\n' "$MAILMCP_RUNTIME_ROLE"

  local -a psql_command=(psql --no-psqlrc --quiet --set ON_ERROR_STOP=1 --set runtime_role="$MAILMCP_RUNTIME_ROLE")
  [[ -n "$resolved_connection" ]] && psql_command+=(-- "$resolved_connection")

  "${psql_command[@]}" <<'GRANT_RUNTIME_ACCESS'
GRANT USAGE ON SCHEMA public TO :"runtime_role";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO :"runtime_role";
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO :"runtime_role";

-- For everything a later migration creates. `FOR ROLE CURRENT_USER` is what keeps this within the migrator's own
-- authority: a role may always set the default privileges of objects it will itself create.
ALTER DEFAULT PRIVILEGES FOR ROLE CURRENT_USER IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO :"runtime_role";
ALTER DEFAULT PRIVILEGES FOR ROLE CURRENT_USER IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO :"runtime_role";
GRANT_RUNTIME_ACCESS
}

main() {
  [[ -r "$schema_script" ]] || fail "the schema script is missing from this image at ${schema_script}."

  case "${1:---apply}" in
    --apply)
      apply_schema
      ;;
    --print)
      cat -- "$schema_script"
      ;;
    --help | -h)
      usage
      ;;
    *)
      usage >&2
      fail "unrecognized argument '$1'."
      ;;
  esac
}

main "$@"
