<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cli\Cli.csproj" />
  </ItemGroup>

  <!-- The suite's one HTTP test double, compiled here the way every other consumer compiles it. NSubstitute cannot
       produce one, because HttpMessageHandler.SendAsync is protected. -->
  <ItemGroup>
    <Compile Include="..\shared\FakeHttpMessageHandler.cs" Link="FakeHttpMessageHandler.cs" />
    <Compile Include="..\shared\RecordedHttpRequest.cs" Link="RecordedHttpRequest.cs" />
  </ItemGroup>

  <!-- The certificates the transport-trust tests decide about, issued in memory so no key or anchor is committed. -->
  <ItemGroup>
    <Compile Include="..\shared\TestCertificates.cs" Link="TestCertificates.cs" />
  </ItemGroup>

  <!-- The command publishes a span of its own, so its names are held against the same contract every other boundary's
       are. The host's own suite reads the assemblies the host references, which this is deliberately not one of. -->
  <ItemGroup>
    <Compile Include="..\shared\TelemetryRedactionContract.cs" Link="TelemetryRedactionContract.cs" />
  </ItemGroup>
</Project>
