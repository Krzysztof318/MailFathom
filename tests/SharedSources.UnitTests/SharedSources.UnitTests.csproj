<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- LargeSyntheticMessage from tests/shared composes the generated description into MIME. -->
    <PackageReference Include="MimeKit" />
    <!-- PropertyCheck from tests/shared wraps this generator, so the project that compiles every shared file needs it
         the same way a consumer does. -->
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <!-- Neither shared directory has a project of its own: both are compiled into every assembly that needs them, so
         the only way to test them is to compile them here the same way a consumer does. -->
    <Compile Include="..\..\src\shared\*.cs" LinkBase="src-shared" />
    <Compile Include="..\shared\*.cs" LinkBase="tests-shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- RecordingLoggerProvider from tests/shared implements ILoggerProvider. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- SyntheticServedAccount from tests/shared builds an application port's value, so this project references what
         every consumer of that file already does. Compiling it any other way would not be compiling it as a consumer. -->
    <ProjectReference Include="..\..\src\Application\Application.csproj" />

    <!-- RecordedMailFathomMeasurements from tests/shared listens to the one process-wide meter Common declares. -->
    <ProjectReference Include="..\..\src\Common\Common.csproj" />

    <!-- LargeSyntheticMessage from tests/shared draws its message from the repository's own deterministic generator. -->
    <ProjectReference Include="..\..\tools\SyntheticMail\SyntheticMail.csproj" />
  </ItemGroup>
</Project>
