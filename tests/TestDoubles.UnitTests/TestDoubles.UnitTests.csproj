<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared test doubles have no project of their own: they are compiled into every test project that uses
         them, so the only way to test them is to compile them here the same way a consuming project does. -->
    <Compile Include="..\shared\*.cs" LinkBase="shared" />
  </ItemGroup>
</Project>
