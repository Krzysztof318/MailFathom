{
  "platformOptions": {
    "Coverlet": {
      "Include": "[MailFathom.*]*",
      "Exclude": "[MailFathom.Host]*,[MailFathom.AppHost]*,[MailFathom.IntegrationTests]*,[coverlet.*]*,[xunit.*]*,[Microsoft.Testing.*]*,[Microsoft.TestPlatform.*]*,[Microsoft.VisualStudio.TestPlatform.*]*,[testhost*]*",
      "ExcludeByAttribute": "ExcludeFromCodeCoverage,ExcludeFromCodeCoverageAttribute,GeneratedCodeAttribute",
      "ExcludeByFile": "**/Persistence/Migrations/*.cs",
      "Format": "cobertura",
      "IncludeTestAssembly": false,
      "DeterministicReport": true,
      "ExcludeAssembliesWithoutSources": "MissingAll"
    }
  }
}
