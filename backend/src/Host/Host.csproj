<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The store a developer's mailbox password and MCP key live in. Every credential this host reads is a secret
         reference or, under the Development interpretation, an inline value, and both belong outside the tree; the
         secret store the framework already loads in Development is where they go, so nothing has to be un-staged
         before a commit. The identifier is fixed rather than generated per clone, so the operations documentation can
         name the command that writes into it and every checkout writes into the same store. -->
    <UserSecretsId>mailfathom-c24be749-2609-4926-a560-be8b4c8aac0e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Design-time only, and referenced for the tooling rather than for any code here: dotnet-ef requires the startup
         project to carry it, and the AppHost's migration resource names this project as the startup project because it
         is the resource the orchestration issues the connection string to. Infrastructure remains where the context,
         the design-time factory, and the migrations live. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI\AI.csproj" />
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Mcp\Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\StampedAssemblyVersion.cs" Link="StampedAssemblyVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MailFathom.Host.UnitTests" />
    <!-- The composition and the pipeline are internal, and the integration suite starts both: what middleware order a
         started host actually serves a request through exists nowhere else. -->
    <InternalsVisibleTo Include="MailFathom.IntegrationTests" />
    <!-- Every configuration section is bound into an internal options class, so the suite that records the published
         configuration key set has to name those classes to walk them. -->
    <InternalsVisibleTo Include="MailFathom.PublicSurfaces.UnitTests" />
  </ItemGroup>

  <!-- The OpenAPI package ships a source generator that folds this project's XML documentation comments into the
       generated document, and it cannot run here. It builds one dictionary keyed by documentation ID across this
       compilation and every referenced assembly's XML file, and `MailFathom.Versioning.StampedAssemblyVersion` is
       compiled into both this project and `Mcp` from `backend/src/shared/` — so the cache is built with a duplicate key
       and every request for the document fails with an ArgumentException at runtime rather than at build time. It is
       the unresolved half of https://github.com/dotnet/aspnetcore/issues/67192, reported as
       https://github.com/dotnet/aspnetcore/issues/64378, and removing the generator is the workaround the OpenAPI
       documentation itself gives. What it costs is descriptions on operations and schemas; what it buys is a document
       that generates at all, and one that does not change whenever a comment is reworded.
       Removed in a target rather than in a plain item group, because NuGet contributes the analyzer during
       ResolvePackageAssets, which runs after this project's own items have been evaluated. -->
  <Target Name="RemoveOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <!-- The native artifact is this project's publish output, and so is the container image, which copies that output
       and nothing else. The Apache-2.0 grant and the original-author attribution therefore travel with both, rather
       than being attached by a release step nobody runs the same way twice. -->
  <ItemGroup>
    <None Include="$(RepositoryRoot)LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(RepositoryRoot)NOTICE" Link="NOTICE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A missing source file makes the items above resolve to nothing and publish silently succeeds, which is the one
       failure this has to rule out: an artifact that ships without its license is the defect, not a build that stops. -->
  <Target Name="VerifyPublishedLicenseAndNotice" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)LICENSE')"
           Text="The published artifact has no LICENSE. Restore the repository root LICENSE before publishing." />
    <Error Condition="!Exists('$(PublishDir)NOTICE')"
           Text="The published artifact has no NOTICE. Restore the repository root NOTICE before publishing." />
  </Target>
</Project>
