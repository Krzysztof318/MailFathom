<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The enrichment half of the Aspire PostgreSQL EF Core integration only. It layers the health check and the
         OpenTelemetry wiring onto a context this project registers itself, so it adds no dependency on an orchestrator
         being present at run time. -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- The client the object-storage content backend reaches its S3-compatible endpoint over. Referenced by this
         project alone, so every Amazon type stays inside the adapter under ObjectStorage/ and no application port, use
         case, or domain type ever sees one. AWSSDK.Core beside it is the runtime that carries the credential, the
         endpoint configuration, and the signer; it is named directly for the reason MimeKit is, so the version the code
         compiles against is decided in Directory.Packages.props rather than inherited from a dependency range. -->
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.Core" />
    <!-- The HTML parser the reading pane's document projection walks. It arrived here transitively behind
         HtmlSanitizer and is named directly now that this project holds a parsed document of its own: the reduction to
         MailDocument is a walk over AngleSharp's DOM rather than a second pass over somebody's markup, which is what
         keeps a second parser out of the client. Referenced by this project alone, so the type stays inside the
         adapter that owns parsing and reaches no other boundary. -->
    <PackageReference Include="AngleSharp" />
    <!-- The HTML sanitizer for message bodies. It is referenced by this project alone, so the AngleSharp stack it
         carries stays inside the adapter that owns sanitization and reaches no other boundary. -->
    <PackageReference Include="HtmlSanitizer" />
    <!-- The DNS lookups the local DKIM verification makes. Referenced by this project alone, so the resolver stays
         behind the application port that names the one place this system reaches the network to judge a sender. -->
    <PackageReference Include="DnsClient" />
    <!-- Named directly because the DKIM key locator declares the key type MimeKit's locator contract returns. It is the
         one type of this package MailFathom compiles against, and it never leaves the adapter that verifies signatures. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="MailKit" />
    <!-- Referenced directly rather than relied on through MailKit, because message parsing uses MimeKit's own API and
         the version that compiles must be pinned here instead of inherited from another package's dependency range. -->
    <PackageReference Include="MimeKit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- The client factory and the one call that opts a named client out of the standard resilience handler. Referenced
         through the resilience package rather than Microsoft.Extensions.Http directly, because the opt-out lives here
         and this package carries the factory along; the host resolves the same pair from the ASP.NET Core shared
         framework, which is why it appears in this project's lock file and not in the host's. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- The secret-detection corpus and the type a rule is declared as: `RegexPattern`, which also reads its own match
         back to say which product issued a key, the option defaults its expressions are built with, and the Microsoft
         credential formats adopted as `ProviderToken` rules. The scanner runs that corpus itself, so the package's
         masker is unused. It carries no package dependencies of its own, so the whole of it stays inside the scanning
         adapter. -->
    <PackageReference Include="Microsoft.Security.Utilities.Core" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- The condition language a mail rule is authored in. Referenced by this project alone, so the parser, its AST,
         and every NCalc type stay inside the adapter that compiles and evaluates a condition; Application and Domain
         see a compiled condition through their own port and never an expression. -->
    <PackageReference Include="NCalc" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="Polly.RateLimiting" />
    <!-- Named directly because the password attempt limiter compiles against PartitionedRateLimiter and
         ConcurrencyLimiter, for the reason MimeKit and AWSSDK.Core are: the version the code compiles against is
         decided in Directory.Packages.props rather than inherited from Polly.RateLimiting's dependency range. Host
         resolves the same assembly from the ASP.NET Core shared framework and needs no reference of its own. -->
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\RequiresIntegrationCoverageAttribute.cs" Link="RequiresIntegrationCoverageAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MailFathom.Infrastructure.UnitTests" />
    <InternalsVisibleTo Include="MailFathom.IntegrationTests" />

    <!--
      The two projects that measure what this boundary costs rather than what it answers: the allocation budgets the
      unit suite gates on, and the nightly throughput report. The MIME readers and the stored-content row they measure
      are internal like every other adapter here, and a wrapper published for them would put a second shape between the
      measurement and the path a deployment runs.
    -->
    <InternalsVisibleTo Include="MailFathom.AllocationBudgets.UnitTests" />
    <InternalsVisibleTo Include="MailFathom.Benchmarks" />

    <!--
      NSubstitute proxies a type at run time from a generated assembly, which the two grants above do not name, so an
      internal interface is refused with an accessibility error rather than substituted. ISubmissionClient is one:
      it is the mail library's client contract with the per-recipient replies added, and a test scripts a submission
      server through it instead of opening a socket. The name is Castle DynamicProxy's fixed one.
    -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
