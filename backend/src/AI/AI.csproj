<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- The client factory and the one call that opts the embedding transport out of the standard resilience handler,
         for the reason `docs/architecture/outbound-resilience.md` states: that call already runs under the
         AiProviderInvocation pipeline, and keeping both would put two retry layers around one request. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MailFathom.AI.UnitTests" />
    <InternalsVisibleTo Include="MailFathom.IntegrationTests" />

    <!--
      The two projects that measure what this boundary costs rather than what it answers: the allocation budgets the
      unit suite gates on, and the nightly throughput report. Both are about the chunker, which is internal like every
      other implementation here, and neither would be measuring the production path through a wrapper.
    -->
    <InternalsVisibleTo Include="MailFathom.AllocationBudgets.UnitTests" />
    <InternalsVisibleTo Include="MailFathom.Benchmarks" />
  </ItemGroup>
</Project>
