<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The binder proves that a secret block binds from flat colon-separated keys, which is the path a pre-resolving
         configuration provider and an environment block both take. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\RecordingLoggerProvider.cs" Link="RecordingLoggerProvider.cs" />
    <Compile Include="..\shared\ExceptionHierarchyAssertion.cs" Link="ExceptionHierarchyAssertion.cs" />
    <!-- The contact mapping writes the owner whose book a row belongs to, so its tests name the same two owners every
         other suite arranges. -->
    <Compile Include="..\shared\SyntheticMailOwner.cs" Link="SyntheticMailOwner.cs" />
    <Compile Include="..\shared\FixedSensitiveContentPostures.cs" Link="FixedSensitiveContentPostures.cs" />
    <Compile Include="..\shared\TestCertificates.cs" Link="TestCertificates.cs" />
    <!-- The bounded metadata handler is the one Infrastructure type that speaks HTTP, and the suite's single HTTP test
         double is hand-written because a substitute cannot override the protected send path. -->
    <Compile Include="..\shared\FakeHttpMessageHandler.cs" Link="FakeHttpMessageHandler.cs" />
    <Compile Include="..\shared\RecordedHttpRequest.cs" Link="RecordedHttpRequest.cs" />
    <!-- The body text is the one mail-rule fact whose resolution costs a read, and both this project and
         Application.UnitTests prove a claim about how often it happens. -->
    <Compile Include="..\shared\RecordingMailRuleBodyTextReader.cs" Link="RecordingMailRuleBodyTextReader.cs" />

    <!-- A fact surface is built with the folder mappings a condition naming a folder's role reads, so a condition test
         supplies one whether or not it is about roles. -->
    <Compile Include="..\shared\StubMailFolderMappings.cs" Link="StubMailFolderMappings.cs" />

    <!-- Every boundary that publishes instruments asserts them the same way, through a listener over the one
         process-wide meter, so the recorder is built once rather than per suite. -->
    <Compile Include="..\shared\RecordedMailFathomMeasurements.cs" Link="RecordedMailFathomMeasurements.cs" />

    <!-- The redaction contract is asserted in every assembly that publishes a signal, so the recorder that reads the
         whole surface and the rules it is held against are shared rather than restated. The recorder reuses the
         measurement record the file above declares, so the two are included together. -->
    <Compile Include="..\shared\EmittedTelemetrySurface.cs" Link="EmittedTelemetrySurface.cs" />
    <Compile Include="..\shared\TelemetryRedactionContract.cs" Link="TelemetryRedactionContract.cs" />
  </ItemGroup>
</Project>
