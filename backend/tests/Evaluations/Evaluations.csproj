<Project Sdk="Microsoft.NET.Sdk">
  <!-- What an agent answers, measured against the models a run declares and judged by one pinned model. Nothing
       discovers it as a test: backend/Directory.Build.props opts it out of discovery, and scripts/run-ai-evaluations.sh
       is what runs it. Every scenario that calls a provider skips unless MAILFATHOM_AI_EVALUATIONS asks for it. -->
  <PropertyGroup>
    <!-- AIEVAL001 marks the agent-quality evaluators — intent resolution, task adherence, tool-call accuracy — as open to
         change. Measuring an agent is the only thing this project does, so a change there is one it has to absorb anyway,
         and a suppression at each use would say the same thing a dozen times. -->
    <NoWarn>$(NoWarn);AIEVAL001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.NLP" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model-written corpus the development command replays, read here as it was committed. It is the one input a
         scenario may send a provider: every address in it is under a reserved domain and nobody received any of it. -->
    <None Include="..\..\tools\SyntheticMail\corpora\office-en.zip" Link="corpora\office-en.zip" CopyToOutputDirectory="PreserveNewest" />
    <!-- The hand-written conversations read after it, carrying the shapes of real mail the model-written one has none of:
         a long thread with several correspondents, a later message correcting an earlier one, quoted speakers, a
         relative date, and two people with nearly the same name. -->
    <None Include="..\..\tools\SyntheticMail\corpora\hard-shapes-en.zip" Link="corpora\hard-shapes-en.zip" CopyToOutputDirectory="PreserveNewest" />
    <!-- The hand-written Polish mail, read beside the English corpora and never into them, so the language cases have
         mail to read and the English cases keep searching the mailbox they were written against. -->
    <None Include="..\..\tools\SyntheticMail\corpora\office-pl.zip" Link="corpora\office-pl.zip" CopyToOutputDirectory="PreserveNewest" />
    <!-- The images the describer is shown, which the corpus has none of: drawn for this suite from shapes and text alone,
         so they show nobody real and no real document. -->
    <None Include="Descriptions\Images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Descriptions\Images\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\FakeHttpMessageHandler.cs" Link="FakeHttpMessageHandler.cs" />
    <Compile Include="..\shared\RecordedHttpRequest.cs" Link="RecordedHttpRequest.cs" />
    <!-- The inactive egress guard the answering agent's retrieval is composed with, linked as the set every suite holding
         a guarded egress point links it: every input is synthetic mail, so a scan has nothing to find that the corpus does
         not already publish. -->
    <Compile Include="..\shared\MarkerSensitiveContentScanner.cs" Link="MarkerSensitiveContentScanner.cs" />
    <Compile Include="..\shared\RecordingSensitiveContentEgressTelemetry.cs" Link="RecordingSensitiveContentEgressTelemetry.cs" />
    <Compile Include="..\shared\FixedSensitiveContentPostures.cs" Link="FixedSensitiveContentPostures.cs" />
    <Compile Include="..\shared\SensitiveContentEgressGuards.cs" Link="SensitiveContentEgressGuards.cs" />
    <Compile Include="..\shared\ScanningSensitiveContentEgress.cs" Link="ScanningSensitiveContentEgress.cs" />
    <Compile Include="..\shared\SyntheticUser.cs" Link="SyntheticUser.cs" />
    <!-- The grant a scenario states for the Agent's tools, which decides which of them are offered. -->
    <Compile Include="..\shared\AccessAuthorizations.cs" Link="AccessAuthorizations.cs" />
    <!-- The one account and one inbox the Agent's readers resolve their scope over, and the thread reader that assembles
         each corpus conversation as a deployment's does. -->
    <Compile Include="..\shared\AssignedMailAccountCatalogs.cs" Link="AssignedMailAccountCatalogs.cs" />
    <Compile Include="..\shared\StubMailAccountAssignments.cs" Link="StubMailAccountAssignments.cs" />
    <Compile Include="..\shared\SyntheticServedAccount.cs" Link="SyntheticServedAccount.cs" />
    <Compile Include="..\shared\StubMailFolderParticipation.cs" Link="StubMailFolderParticipation.cs" />
    <Compile Include="..\shared\StubJunkMailFolderCatalog.cs" Link="StubJunkMailFolderCatalog.cs" />
    <Compile Include="..\shared\StubMailFolderMappings.cs" Link="StubMailFolderMappings.cs" />
    <Compile Include="..\shared\StubEmailThreadReader.cs" Link="StubEmailThreadReader.cs" />
    <Compile Include="..\shared\ContactBookOwnerships.cs" Link="ContactBookOwnerships.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI\AI.csproj" />
    <!-- For how a deployment reads a body: a corpus message is cut into passages from the trimmed reading a deployment
         chunks, rather than from the raw body a reply carries its whole history in, and a body carried as markup alone
         is read from the text it displays. -->
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
    <!-- For the defaults a deployment declares: a model under test is planned from the chat model declaration a
         deployment binds, and an embedding profile's metric and every other bound a scenario reads are the host's own
         defaults, so no scenario restates a number the deployment owns. -->
    <ProjectReference Include="..\..\src\Host\Host.csproj" />
    <ProjectReference Include="..\..\tools\SyntheticMail\SyntheticMail.csproj" />
  </ItemGroup>
</Project>
