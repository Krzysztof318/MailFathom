<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <!-- The only prerelease pin in the repository. AddEFMigrations is the sole supported way to run dotnet-ef against
         the orchestration on Aspire 13: the aspire exec command that earlier versions offered no longer exists, and the
         package ships no stable build. It is referenced by AppHost alone, so nothing it carries reaches a deployed
         assembly. -->
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.4.6-preview.1.26319.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <!-- The non-interactive Microsoft Entra credentials an Azure OpenAI endpoint is reached with where no key exists to
         provision. Referenced by AI alone, and only for the four credential types a background service can hold; the
         chain is composed explicitly rather than through DefaultAzureCredential, which would reach a developer tool. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <!-- What draws the command's output: the tables its listings are laid out in, and the colour that tells a failure
         from a result. Referenced by Cli alone. It brings Spectre.Console.Ansi with it, which is the same project under
         the same licence, so both carry a row in THIRD_PARTY_LICENSES.md. Both are trimmable and the trimmed publish is
         what proves it, since nothing a pull request runs reaches one. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- DPAPI, which the base class library does not carry: it ships as this package rather than in the shared
         framework, because it exists on one platform. The command uses it to bind its credential key to the current
         Windows user, and guards the call with a runtime platform check, so a Linux build carries it and never enters
         it. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <!-- The throughput harness `tests/Benchmarks` reports with, and nothing else: it is referenced by that project
         alone, ships nowhere, and gates nothing. Its `net8.0` assets are what .NET 10 resolves, and it recognizes
         net10.0 as a runtime of its own. It brings sixteen transitive packages with it, every one of them recorded in
         THIRD_PARTY_LICENSES.md beside it. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <!-- The generator behind the property tests, which state an invariant once and let generated inputs hunt for the
         counterexample an example test cannot reach. It carries no dependency of its own and couples to no test
         framework — a property is an ordinary [Fact] calling into it — so it costs one assembly in three unit-test
         projects and changes nothing about how the suite is discovered or run. -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <!-- Brings AngleSharp 1.6.0 and AngleSharp.Css 1.0.0 transitively, both MIT. The 9.1 line replaced the exact
         AngleSharp 0.17.1 pin the 9.0 line carried, so nothing here forecloses referencing AngleSharp directly, and
         AngleSharp 1.6.0 publishes a net10.0 target of its own. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.1.974" />
    <!-- The DNS client the local DKIM verification resolves published keys with. The platform offers no TXT lookup at
         all — System.Net.Dns resolves addresses and nothing else — so the alternative was a hand-written resolver
         parsing untrusted wire data. It is Apache-2.0, carries no dependencies of its own on its net8.0 target, and
         reads the operating system's own resolver configuration rather than naming a nameserver of its own. -->
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <!-- MimeKit brings this in transitively and the DKIM key locator names one of its types, because that is what
         MimeKit's locator contract returns. Pinned directly for the reason MimeKit itself is: a version the code
         compiles against is decided here rather than inherited from another package's dependency range. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1" />
    <!-- One client library reaches both supported providers. Azure OpenAI's v1 data plane is OpenAI-compatible, so an
         Azure deployment is this client pointed at `<resource>/openai/v1/`, which is what Microsoft's own current
         guidance shows; Azure.AI.OpenAI would be a second client construction and has published no stable release
         since 2.1.0. -->
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Security.Utilities.Core" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <!-- The expression language a mail rule's condition is written in, taken as the package that carries the
         asynchronous evaluator because a fact resolves through I/O. Referenced by Infrastructure alone, where the
         parser, the validating walk, and the evaluator live. Its graph is wider than the package name suggests —
         NCalc.Core, NCalc.Parser, and NCalc.Domain, plus Parlot and ExtendedNumerics.BigDecimal — so every one of
         them carries a row of its own in THIRD_PARTY_LICENSES.md, and Parlot is not under the same licence as the
         rest. ADR 0010 records why an expression language is admissible here at all and what the closed environment
         around it has to guarantee. -->
    <PackageVersion Include="NCalc" Version="7.1.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <PackageVersion Include="Polly.Extensions" Version="8.7.0" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.7.0" />
    <!-- The boundary rules that read compiled intermediate language rather than assembly metadata, referenced by
         Boundaries.UnitTests alone. The pin is the xUnit v3 integration, which carries the analyzer itself and with it
         Mono.Cecil, the reader that makes a method body visible at all, plus Newtonsoft.Json, JetBrains.Annotations,
         CycleDetection, and System.ValueTuple. Seven packages for one test project is the whole cost of the
         mechanism, and THIRD_PARTY_LICENSES.md records every one of them. -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <PackageVersion Include="xRetry.v3" Version="1.0.0-rc3" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
