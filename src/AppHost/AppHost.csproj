<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Required by the data volume, not by any secret this repository owns. Aspire generates the PostgreSQL password
         per run and can only keep it stable by writing it to user secrets, so without this identifier a second run
         authenticates with a new password against a volume that kept the first one and the server never becomes
         healthy. The value is a fixed identifier, and the generated password lives in the developer's own profile. -->
    <UserSecretsId>mailmcp-apphost-6f1c0a24-8a2c-4f5c-9d3a-4c2d0f8b71e5</UserSecretsId>
  </PropertyGroup>
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Host\Host.csproj" />
    <!-- Referenced so the project that owns the DbContext and the migrations is built before a migration command runs
         against it, and marked as not a resource because it is a library: the orchestration launches Host, and the
         migration resource names this project by path rather than as something to start. -->
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
