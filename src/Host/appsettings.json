{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MailSynchronization": {
    "Enabled": false,
    "Interval": "00:05:00",
    "Accounts": [],
    "MaxMetadataBatchSize": 100,
    "MaxRawMimeBytes": 26214400,
