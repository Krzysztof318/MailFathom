{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MailSynchronization": {
    "Enabled": false,
    "Interval": "00:05:00",
    "Accounts": [],
    "MaxMetadataBatchSize": 100,
    "MaxRawMimeBytes": 26214400,
    "MaxMetadataBatchesPerRun": 10,
    "MaxMimePartCount": 1000,
    "MaxMimeNestingDepth": 30
  },
  "Persistence": {
    "MaximumConcurrencyCommitAttempts": 2
  },
  "MailboxSearch": {
    "SnippetsPerEmail": 3,
    "WordsPerSnippet": 24
  },
  "ConnectionStrings": {
    "mailmcp": "Host=localhost;Database=mailmcp;Username=mailmcp"
  }
}
