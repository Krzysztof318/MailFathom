{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MailSynchronization": {
    "Enabled": false,
    "Interval": "00:05:00",
    "MaxFailureBackoff": "00:30:00",
    "MaxConcurrentAccounts": 4,
    "MaxConcurrentFoldersPerAccount": 1,
    "WriteConnectionIdlePeriod": "00:02:00",
    "MaxMutationAttempts": 5,
    "ShutdownDrainTimeout": "00:00:10",
    "Accounts": [],
    "MaxMetadataBatchSize": 100,
    "MaxRawMimeBytes": 26214400,
    "MaxMetadataBatchesPerRun": 10,
    "MaxMimePartCount": 1000,
    "MaxMimeNestingDepth": 30
  },
  "Persistence": {
    "MaximumConcurrencyCommitAttempts": 2
  },
  "MailboxSearch": {
    "SnippetsPerEmail": 3,
    "WordsPerSnippet": 24
  },
  "McpEndpoint": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "mailfathom": "Host=localhost;Database=mailfathom;Username=mailfathom"
  }
}
